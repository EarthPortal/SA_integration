    skos:prefLabel "SEPS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Source Loss-Cone Energetic Particle Spectrometer"@en ] ;
    gcmd:resource [ gcmd:type "IMAGE" ;
            gcmd:url "http://www.css.taylor.edu/~physics/seps-1/images/seps_instrument.jpg" ] .

