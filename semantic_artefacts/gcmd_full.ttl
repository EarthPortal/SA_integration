      Instrument_Subtype: Spectrometers
      Short_Name: TANSO-CAI
      Long_Name: Thermal And Near-infrared Sensor for carbon Observation - Cloud and Aerosol Imager
   End_Group
   Creation_Date: 2012-08-30
End_Group"""@en ;
