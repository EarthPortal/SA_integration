    skos:definition """A SNOWPACK TEMPERATURE PROBE is a device that measures the
temperature of a laterally extensive accumulation of snow on the
ground that persists through winter and melts in the spring and
summer."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "SNOWPACK TEMPERATURE PROBE"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "SNOWPACK TEMPERATURE PROBE"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/d8ff2cc4-d922-4661-8bba-fd78c7672ce9> a skos:Concept ;
