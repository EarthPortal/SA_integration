   End_Group
   Group: Platform_Associated_Instruments
      Short_Name: WAVES
      Short_Name: MUON COSMIC RAY DETECTORS
      Short_Name: PROBES
      Short_Name: FLUXGATE MAGNETOMETERS
   End_Group
