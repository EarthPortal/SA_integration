<https://gcmd.earthdata.nasa.gov/kms/concept/b92ec1f1-157e-4778-8bb3-c60a929bd1de> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/0a184cdc-c074-4946-90a6-02f03c686341> ;
    skos:changeNote """2022-05-25 16:32:59.0 [sritz] Insert Concept 
add broader relation (GEOS [b92ec1f1-157e-4778-8bb3-c60a929bd1de,938200] - Models [0a184cdc-c074-4946-90a6-02f03c686341,928092]); 
""",
        """2022-05-25 16:34:01.0 [sritz]  
insert AltLabel (id: null
category: primary
text: Goddard Earth Observing System
language code: en); 
""",
        """2022-05-25 16:37:11.0 [sritz]  
insert Definition (id: null
text: The Goddard Earth Observing System (GEOS) model consists of a group of model components that can be connected in a flexible manner in order to address questions related to different aspects of Earth Science. GEOS model development adheres to the modular architecture of the Earth System Modeling Framework (ESMF). This modular structure simplifies the management of both the model code and the model configurations, to enable progress with forefront applications of coupled processes in the Earth System. GMAO’s work with GEOS spans a large range of space and time scales and encompasses the representation of dynamical, physical, chemical and biological processes.
language code: en); 
""",
        """2022-05-25 16:37:30.0 [sritz] Move Concepts 
add narrower relation (GEOS [b92ec1f1-157e-4778-8bb3-c60a929bd1de,938200] - GEOS-4 [b42aa64a-6b63-4fd0-b953-4abf7558008c,928831]); 
""",
        """2022-05-25 16:37:36.0 [sritz] Move Concepts 
add narrower relation (GEOS [b92ec1f1-157e-4778-8bb3-c60a929bd1de,938200] - GEOS-5 [42ad1501-744a-439c-a394-258db03d0304,928340]); 
""",
        """2022-05-25 16:37:41.0 [sritz] Move Concepts 
add narrower relation (GEOS [b92ec1f1-157e-4778-8bb3-c60a929bd1de,938200] - GEOS-Chem [4773815f-2a76-425e-86cc-0bfd4c3b75c2,928365]); 
""",
        """2022-06-23 17:16:00.0 [sritz] Insert Concept 
add narrower relation (GEOS [b92ec1f1-157e-4778-8bb3-c60a929bd1de,943468] - GEOS [a3ca2fcc-658a-4249-b9b7-40a8bb5e03a9,952820]); 
""" ;
    skos:definition "The Goddard Earth Observing System (GEOS) model consists of a group of model components that can be connected in a flexible manner in order to address questions related to different aspects of Earth Science. GEOS model development adheres to the modular architecture of the Earth System Modeling Framework (ESMF). This modular structure simplifies the management of both the model code and the model configurations, to enable progress with forefront applications of coupled processes in the Earth System. GMAO’s work with GEOS spans a large range of space and time scales and encompasses the representation of dynamical, physical, chemical and biological processes."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/42ad1501-744a-439c-a394-258db03d0304>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/4773815f-2a76-425e-86cc-0bfd4c3b75c2>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/a3ca2fcc-658a-4249-b9b7-40a8bb5e03a9>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/b42aa64a-6b63-4fd0-b953-4abf7558008c> ;
    skos:prefLabel "GEOS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Goddard Earth Observing System"@en ] ;
    gcmd:reference [ gcmd:text "https://gmao.gsfc.nasa.gov/GEOS_systems/"@en ] .

