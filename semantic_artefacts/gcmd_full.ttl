        """2020-04-15 09:21:08.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Liquid Waveguide Capillary Cells
language code: en); 
insert Definition (id: null
text: WPI’s Liquid Waveguide Capillary Cell (LWCC) is a flow cell for absorbance measurements in the ultraviolet, visible and near infra-red ranges. Pathlengths range from 50–500cm, with increasing measurement sensitivity from 50 to 500-fold. The flow cells are fiber coupled and have a very small sample volume ranging from 125μL (50cm pathlength) to 1,250μL (500cm pathlength).
language code: en); 
""" ;
    skos:definition "WPI’s Liquid Waveguide Capillary Cell (LWCC) is a flow cell for absorbance measurements in the ultraviolet, visible and near infra-red ranges. Pathlengths range from 50–500cm, with increasing measurement sensitivity from 50 to 500-fold. The flow cells are fiber coupled and have a very small sample volume ranging from 125μL (50cm pathlength) to 1,250μL (500cm pathlength)."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "LWCC"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Liquid Waveguide Capillary Cells"@en ] ;
    gcmd:reference [ gcmd:text "https://www.wpiinc.com/pub/media/wysiwyg/pdf/DS/LWCC.pdf"@en ] .

