    skos:prefLabel "GOCE"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Gravity Field and Steady-State Ocean Circulation Explorer"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/b50a200b-ee56-48b2-8329-57cf8d71360c> a skos:Concept ;
