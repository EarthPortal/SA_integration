    skos:prefLabel "LONGSHORE CURRENTS"@en ;
    gcmd:reference [ gcmd:text """Garrison, T. 1993. Oceanography, An Invitation to Marine Science. Wadsworth
Publishing Co. p. 521."""@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/ccf920b3-c5a0-4408-8c84-0cc8743adc33> a skos:Concept ;
