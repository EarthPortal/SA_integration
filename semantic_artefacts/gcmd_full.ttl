        """2020-11-12 16:50:41.0 [sritz]  
insert AltLabel (id: null
category: primary
text: Picarro G2201-I Isotopic Analyzer for CO2 and CH4
language code: en); 
insert Definition (id: null
text: The Picarro G2201-i isotope analyzer combines capabilities of two Picarro δ13C carbon isotope instruments for CO2 and CH4 into a single instrument. Now it’s easy and fast to capture the insights that only stable isotope ratios offer. Researchers can follow carbon as it moves from source to sink with a single instrument. The dual-purpose analyzer brings simplicity and speed to research. Its small size and robustness make it easy to transport to the field, where immediate results allow researchers to change course on-the-fly and achieve optimal results from limited-time field campaigns.
language code: en); 
""" ;
    skos:definition "The Picarro G2201-i isotope analyzer combines capabilities of two Picarro δ13C carbon isotope instruments for CO2 and CH4 into a single instrument. Now it’s easy and fast to capture the insights that only stable isotope ratios offer. Researchers can follow carbon as it moves from source to sink with a single instrument. The dual-purpose analyzer brings simplicity and speed to research. Its small size and robustness make it easy to transport to the field, where immediate results allow researchers to change course on-the-fly and achieve optimal results from limited-time field campaigns."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "Picarro G2201-i"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Picarro G2201-I Isotopic Analyzer for CO2 and CH4"@en ] ;
    gcmd:reference [ gcmd:text "https://www.picarro.com/products/g2201i_isotopic_analyzer"@en ] .

