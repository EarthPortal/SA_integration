add broader relation (Swarm-A [054787a6-0c47-43af-a4ee-05c572dd1705,367699] - Swarm [1d6d5f82-acd5-4bd2-9324-12884718b353,367695]); 
""",
        """2019-02-22 16:33:34.0 [mmorahan]  
insert Definition (id: null
