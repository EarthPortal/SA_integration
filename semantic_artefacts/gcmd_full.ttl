    skos:prefLabel "SSALT"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "POSEIDON Solid State Radar Altimeter"@en ] ;
    gcmd:resource [ gcmd:type "IMAGE" ;
            gcmd:url "http://sealevel.jpl.nasa.gov/gallery/spacecraft/gifs/BHT.jpg" ] .

