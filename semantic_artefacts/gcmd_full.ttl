        <https://gcmd.earthdata.nasa.gov/kms/concept/e58bc59d-a030-4cc4-80a9-f9cb7f294244>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/fb5ac938-4c9a-4abd-9b62-7ae1ac63b34e> ;
    skos:prefLabel "Orbiting Solar Observatory (OSO)"@en ;
    gcmd:reference [ gcmd:text "Todd Neff (2010) From Jars to the Stars: How Ball Came to Build a Comet-Hunting Machine Archived 18 March 2018 at the Wayback Machine Denver, CO.: Earthview Media."@en ] .

