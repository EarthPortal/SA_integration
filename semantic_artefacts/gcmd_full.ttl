      Short_Name: COSTEP
      Long_Name: Comprehensive Suprathermal and Energetic Particle Analyzer
   End_Group
   Group: Instrument_Associated_Sensors
      Short_Name: LION
      Short_Name: EPHIN
   End_Group
   Group: Associated_Platforms
      Short_Name: SOHO
   End_Group
   Online_Resource: http://www.ieap.uni-kiel.de/et/ag-heber/costep/
   Online_Resource: http://ifkki.kernphysik.uni-kiel.de/SOHO/engl/homepage
   Sample_Image: http://www.ieap.uni-kiel.de/et/ag-heber/costep/images/figures/index_fig1.jpg
   Group: Instrument_Logistics
      Instrument_Start_Date: 1995-12-02
      Instrument_Owner: Institut fur Experimentele und Angewandte Physik
   End_Group
End_Group"""@en ;
