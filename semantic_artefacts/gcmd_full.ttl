<https://gcmd.earthdata.nasa.gov/kms/concept/adfee6d2-ca00-4f02-a570-5ccf0850cb55> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/e1f20631-b5b9-438c-b5c2-b1fa0fce100a> ;
    skos:definition """Predicts the fast time scale fluxes of water, carbon, nitrogen and energy\r
between the landsurface and the atmosphere and the resulting diurnal surface\r
fluxes, seasonal and inter-annual vegetation growth, and decadal to century\r
scale alterations in vegetation structure and soil carbon and nitrogen. It\r
will be made available to the climate modeling community for studies on\r
seasonal weather evolution, vegetation phenology, the carbon budget, climate\r
variability, paleoclimate, global change scenarios, vegetation-climate\r
feedbacks, and astronomical biosignatures."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "DYNAMIC VEGETATION/ECOSYSTEM MODELS"@en ;
    gcmd:reference [ gcmd:text "FACTS-I, Duke University"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/adffbac6-6ba0-4191-b80c-628fd42c6fe7> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/def72d78-3c2f-4f46-91e7-259a0e63e2de> ;
