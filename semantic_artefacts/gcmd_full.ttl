      Number_Channels: 2
      Spectral_Frequency_Coverage_Range: 3 eV - 11 MeV
   End_Group
   Online_Resource: http://sprg.ssl.berkeley.edu/wind3dp/esahome.html
   Sample_Image: http://sprg.ssl.berkeley.edu/wind3dp/images/windpartbig.gif
   Group: Instrument_Logistics
      Instrument_Start_Date: 1994-11-01
      Instrument_Owner: University of California, Berkeley
      Instrument_Owner: NASA
   End_Group
End_Group"""@en ;
