<https://gcmd.earthdata.nasa.gov/kms/concept/2e83362e-d8f8-4bca-83fd-bae360ebe94b> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/57383ac5-614c-4b84-9202-e137b000422b> ;
    skos:definition """Any change in the sun's appearance or behavior. The sun's activity\r
is described as being very low, low, moderate, high or very high.\r
Solar activity changes over a period of, on average, 11 years. At\r
solar maximum, the solar activity is high and so too the Extreme\r
Ultraviolet (EUV) radiation output which affects the ionosphere. At solar \r
minimum, the opposite is true."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/0d32a340-ee64-4795-9254-09dcaf55bf4c>,
