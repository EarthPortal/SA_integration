        """2021-05-12 09:38:07.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Campbell Scientific 107 Temperature Probe
language code: en); 
insert Definition (id: null
text: The 107 is a rugged, accurate probe that measures temperature of air, soil, or water from -35° to +50°C. It easily interfaces with most Campbell Scientific data loggers and can be used in a variety of applications.

The 107 consists of a thermistor encapsulated in an epoxy-filled aluminum housing. The housing protects the thermistor, allowing you to bury the probe in soil or submerge it in water.
language code: en); 
""" ;
    skos:definition """The 107 is a rugged, accurate probe that measures temperature of air, soil, or water from -35° to +50°C. It easily interfaces with most Campbell Scientific data loggers and can be used in a variety of applications.

The 107 consists of a thermistor encapsulated in an epoxy-filled aluminum housing. The housing protects the thermistor, allowing you to bury the probe in soil or submerge it in water."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
