        <https://gcmd.earthdata.nasa.gov/kms/concept/f0bbea2f-2ef0-4e99-ad76-1aedbbedc016> ;
    skos:prefLabel "CREVASSES"@en ;
    gcmd:reference [ gcmd:text "PhysicalGeography.net"@en ] .

