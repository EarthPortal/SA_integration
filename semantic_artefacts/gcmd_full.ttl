insert AltLabel (id: null
category: primary
text: Hawkeye 2D-S Stereo Probe
language code: en); 
insert Definition (id: null
text: The Hawkeye probe was initially developed by SPEC to fly on the NASA Global Hawk Unmanned Aerial Vehicle (UAV). The Hawkeye is an outgrowth of the 3V-CPI, including all of the features of the 3V-CPI, with the addition of an FCDP (Fast Cloud Droplet Probe) in the front part of the sample tube, and the conversion of one 10-micron channel to a 50-micron channel in the 2D-S portion of the probe. In this way, the Hawkeye is actually a combination of four probes in one.
language code: en); 
""" ;
    skos:definition "The Hawkeye probe was initially developed by SPEC to fly on the NASA Global Hawk Unmanned Aerial Vehicle (UAV). The Hawkeye is an outgrowth of the 3V-CPI, including all of the features of the 3V-CPI, with the addition of an FCDP (Fast Cloud Droplet Probe) in the front part of the sample tube, and the conversion of one 10-micron channel to a 50-micron channel in the 2D-S portion of the probe. In this way, the Hawkeye is actually a combination of four probes in one."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "Hawkeye 2DS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
