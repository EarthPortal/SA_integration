        <https://gcmd.earthdata.nasa.gov/kms/concept/2e544263-d92f-46c2-9568-25e36d0b9825>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/4931dcac-8b89-4bc9-ba59-469cfdcf6f12>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/78e5e44c-7832-456d-a599-893ea87ae695>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/b1ce822a-139b-4e11-8bbe-453f19501c36>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/c82f3480-545f-4491-83f1-0477369ddcd8> ;
    skos:prefLabel "FROZEN GROUND"@en ;
    gcmd:reference [ gcmd:text """American Meteorological Society Glossary of Meteorology Online\r
"http://amsglossary.allenpress.com/glossary\""""@en ] .

