<https://gcmd.earthdata.nasa.gov/kms/concept/bdfa3404-c00d-45fe-a3c1-31389a831ffc> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/14555831-70ae-4650-8983-956d65595575> ;
    skos:changeNote """2020-05-07 14:41:36.0 [tstevens] Insert Concept 
add broader relation (WATER STORAGE [bdfa3404-c00d-45fe-a3c1-31389a831ffc,560029] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]); 
""",
        """2020-05-08 08:39:19.0 [tstevens] Insert Concept 
add narrower relation (WATER STORAGE [bdfa3404-c00d-45fe-a3c1-31389a831ffc,560029] - ICE STUPA [73a50bfa-6a0a-4a36-ace4-2c424db05ab8,560069]); 
""" ;
    skos:definition "Monitoring water storage and its variations is impor-tant to understanding local hydrological processesand the global water cycle, which sustains all life onEarth. The development of satellite remote-sensingtechniques has benefited the retrieval of terrestrialwater storage and its variations, which has emerged asa new discipline. Focusing on terrestrial water storage,this  chapter  describes  three  major  retrievalapproaches: the water-balance-based approach, thesurface-parameter-based approach, and the GravityRecovery and Climate Experiment (GRACE)-basedapproach. Accurate estimates of terrestrial waterstorage and its variations are still being developed."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/73a50bfa-6a0a-4a36-ace4-2c424db05ab8> ;
    skos:prefLabel "WATER STORAGE"@en ;
    gcmd:reference [ gcmd:text "https://www.sciencedirect.com/sdfe/pdf/download/eid/3-s2.0-B9780123859549000216/first-page-pdf"@en ] .

