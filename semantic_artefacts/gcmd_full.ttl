category: primary
text: HawkEye Ocean Color Sensor
language code: en); 
insert Definition (id: null
text: The Hawkeye instrument, flown onboard the SeaHawk CubeSat, was optimized to provide high quality, high resolution imagery (120 meter) of the open ocean, coastal zones, lakes, estuaries and land features. This ability provides a valuable complement to the lower resolution measurements from previous missions like SeaWiFS, MODIS and VIIRS. The SeaHawk CubeSat mission is a partnership between NASA and the University of North Carolina, Wilmington (UNCW), Cloudland Instruments and AAC-Clyde Space and is funded by the Moore Foundation under a grant for the Sustained Ocean Color Observations with Nanosatellites (SOCON).
language code: en); 
""",
        """2022-12-01 13:07:49.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 9215de74-2008-4a64-8760-f58f16ae7d14
relationship type: null
relationship value: null
generated by: null); 
""" ;
    skos:definition "The Hawkeye instrument, flown onboard the SeaHawk CubeSat, was optimized to provide high quality, high resolution imagery (120 meter) of the open ocean, coastal zones, lakes, estuaries and land features. This ability provides a valuable complement to the lower resolution measurements from previous missions like SeaWiFS, MODIS and VIIRS. The SeaHawk CubeSat mission is a partnership between NASA and the University of North Carolina, Wilmington (UNCW), Cloudland Instruments and AAC-Clyde Space and is funded by the Moore Foundation under a grant for the Sustained Ocean Color Observations with Nanosatellites (SOCON)."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "HawkEye"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "HawkEye Ocean Color Sensor"@en ] ;
    gcmd:reference [ gcmd:text "https://oceancolor.gsfc.nasa.gov/data/hawkeye/"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/90aa8838-79bd-4b28-b518-8217e863c385> a skos:Concept ;
