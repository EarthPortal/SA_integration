<https://gcmd.earthdata.nasa.gov/kms/concept/283bb108-ea36-4946-99a0-0910946e3265> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/5f5e4f2c-61b7-4694-8680-3fc5799f6171> ;
    skos:definition """The Ultra Low Energy Isotope Spectrometer (ULEIS) on the Advanced
Composition Explorer (ACE) measures ion fluxes over the charge range
from He through Ni from about 20 keV/nucleon to 10 MeV/nucleon, thus
covering both suprathermal and energetic particle energy
ranges. Exploratory measurements of ultra-heavy species (mass range
above Ni) will also be performed in a more limited energy range near
0.5 MeV/nucleon. ULEIS will be studying the elemental and isotopic
composition of solar energetic particles, and the mechanisms by which
these particles are energized in the solar corona. ULEIS will also
investigate mechanisms by which supersonic interplanetary shock waves
energize ions.

ULEIS was designed and developed by ther Johns Hopkins Applied Physics
Laboratory and the University of Maryland


See:
http://sd-www.jhuapl.edu/ACE/ULEIS/


Group: Instrument_Details
   Entry_ID: ULEIS
   Group: Instrument_Identification
      Instrument_Category: Solar/Space Observing Instruments
      Instrument_Class: Particle Detectors
      Short_Name: ULEIS
      Long_Name: Ultra Low Energy Isotope Spectrometer
   End_Group
   Group: Associated_Platforms
      Short_Name: ACE
   End_Group
   Online_Resource: http://sd-www.jhuapl.edu/ACE/ULEIS/
   Sample_Image: http://sd-www.jhuapl.edu/ACE/ULEIS/pics/NEW_ULEISimage4x4.gif
   Group: Instrument_Logistics
      Data_Rate: 1 kbps
      Instrument_Start_Date: 1997-08-25
      Instrument_Owner: Johns Hopkins University Applied Physics Lab
   End_Group
End_Group"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "ULEIS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Ultra Low Energy Isotope Spectrometer"@en ] ;
    gcmd:resource [ gcmd:type "IMAGE" ;
            gcmd:url "http://sd-www.jhuapl.edu/ACE/ULEIS/pics/NEW_ULEISimage4x4.gif" ] .

