<https://gcmd.earthdata.nasa.gov/kms/concept/71c78d69-9cfe-48e9-8dd2-9c75acf22283> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/457883c4-b30c-4d26-bed8-6c2887ebbc90> ;
    skos:definition """Attenuation is the exponential loss of light intensity as light
propagates through water. Attenuation is caused by absorption and
scattering of light energy. Transmission is the measurement of the
percentage of light received at a photo cell placed at fixed distances
from a light source."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "ATTENUATION/TRANSMISSION"@en ;
    gcmd:reference [ gcmd:text """Adapted from: Open University. 1991. Seawater: Its Composition, Properties and
Behaviour. Pergamon Press. p. 60."""@en ] .

