<https://gcmd.earthdata.nasa.gov/kms/concept/5d8a5307-5574-4dd6-b923-8a29d158f008> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/944b7691-af37-4fb4-9393-c114e7997829> ;
    skos:changeNote """2013-07-29 15:33:11.0 [saritz] Updated long name at GHRC request. 
update AltLabel (Conical Scanning Millimeter-wave Imaging Radiometer); 
""" ;
    skos:definition """CoSMIR, originally developed for the calibration/validation of the Special Sensor Microwave/Imager/ Sounder (SSMIS),,  is an airborne, 9-channel total power radiometer modified to have scan mode to acquire both conical and across-track scan data simultaneously in a given flight.  The well-calibrated radiometric data between 50-183 GHz has an  accuracy on the order of ±1 K.

More info can be found at:    http://atmospheres.gsfc.nasa.gov/meso/index.php?section=121


Group: Instrument_Details
   Entry_ID: COSMIR
   Group: Instrument_Identification
      Instrument_Category: Earth Remote Sensing Instruments
      Instrument_Class: Passive Remote Sensing
      Instrument_Type: Spectrometers/Radiometers
      Instrument_Subtype: Imaging Spectrometers/Radiometers
      Short_Name: COSMIR
      Long_Name: Compact Scanning Millimeter-wave Imaging Radiometer
   End_Group
   Group: Associated_Platforms
      Short_Name: NASA ER-2
   End_Group
   Online_Resource: http://atmospheres.gsfc.nasa.gov/meso/index.php?section=121
   Creation_Date: 2012-05-24
   Group: Instrument_Logistics
      Instrument_Owner: USA/NASA
   End_Group
End_Group"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "COSMIR"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Conical Scanning Millimeter-wave Imaging Radiometer"@en ] .

