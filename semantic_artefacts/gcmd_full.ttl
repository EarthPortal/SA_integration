        <https://gcmd.earthdata.nasa.gov/kms/concept/846a5d37-085b-4ae0-9d4d-23b88b6fc304>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/93b2fed5-883f-4d82-9d62-19654d0765ea>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/de965e45-2275-44d6-9193-9387881b538c> ;
    skos:prefLabel "TECHNIQUES"@en ;
    gcmd:reference [ gcmd:text "https://www.earthdata.nasa.gov/data/space-geodesy-techniques"@en ] .

