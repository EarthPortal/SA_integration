    skos:definition """A stratospheric (16 to 35 km altitude) oscillation of equatorial\r
east-west winds which vary with a period of about 26 to 30 months or\r
roughly 2 years; typically blowing for 12-16 months from the east,\r
then reverse and blowing 12-16 months from the west, then back to\r
easterly again."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "QUASI-BIENNIAL OSCILLATION"@en ;
    gcmd:reference [ gcmd:text """Naujokat, B., 1986: An update of the observed quasi-biennial\r
oscillation of the stratospheric winds over the\r
tropics. J. Atmos. Sci., 43, 1873-1877.\r
"http://hurricane.atmos.colostate.edu/forecasts/1999/aug99/definitions.html\""""@en ] .

