        <https://gcmd.earthdata.nasa.gov/kms/concept/bde65cfd-faec-4656-bc27-22dfe30912b7>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/cc676fb2-cf17-413d-bb00-0b95d231f157>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/f5717312-c3ca-4492-a166-9f17c6d9b273> ;
    skos:prefLabel "SULFUR COMPOUNDS"@en ;
    gcmd:reference [ gcmd:text """Brasseur, G.P., J.J. Orlando, and G.S. Tyndall, eds. 1999. Atmospheric
Chemistry and Global Change. New York: Oxford University Press."""@en ] .

