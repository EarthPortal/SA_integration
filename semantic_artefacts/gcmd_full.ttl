""" ;
    skos:definition """Pertaining to the use of remnant magnetic signatures within the rocks of the Earth's crust to determine the state of the Earth's magnetic field at a given time into the past, or to locate a paleocontinent on the surface
of the Earth."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "PALEOMAGNETISM"@en ;
    gcmd:reference [ gcmd:text "NASA Space Science"@en ] .

