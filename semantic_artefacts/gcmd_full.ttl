        """2015-04-07 14:04:26.0 [mpmorahan]  
insert AltLabel (id: null
text: Analog Fluxgate Magnetometer
language code: en); 
insert Definition (id: null
text: The fluxgate magnetometers
provide two sets of similar
measurements. The fluxgates carry a
permeable material that changes
properties in response to the presence
of magnetic fields. Measuring how they
change can be correlated to strength of
the field down to a half a nanotesla –
typical fields in the regions of interest
will be about 50 nanotesla.
The AFG sensors were provided by the
University of California in Los Angeles
and the DFG instrumentation was
provided by the Space Research
Institute of the Austrian Academy of
Sciences in Graz, Austria.
language code: en); 
""" ;
