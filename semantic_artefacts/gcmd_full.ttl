   Sample_Image: http://heasarc.gsfc.nasa.gov/Images/misc_missions/solrad10_small.gif
   Group: Platform_Logistics
      Launch_Date: 1971-07-08
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
