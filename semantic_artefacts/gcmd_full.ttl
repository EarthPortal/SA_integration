        """2021-03-01 16:23:05.0 [sritz]  
insert AltLabel (id: null
category: primary
text: Vertical Cavity Surface Emitting Laser Hygrometer
language code: en); 
insert Definition (id: null
text: The VCSEL hygrometer employs tunable diode laser absorption spectroscopy to determine the water vapor number density over a dew-point range of -90 to +30º C. It reports the water vapor number density at 25 samples per second. From the number density other humidity-related parameters such as dew/frost point, mixing ratio, etc. are derived. It is mounted on a GV aperture plate, weighs 3.2 kg and draws less than 20W from 120 VAC, 60 Hz.
language code: en); 
""" ;
    skos:definition "The VCSEL hygrometer employs tunable diode laser absorption spectroscopy to determine the water vapor number density over a dew-point range of -90 to +30º C. It reports the water vapor number density at 25 samples per second. From the number density other humidity-related parameters such as dew/frost point, mixing ratio, etc. are derived. It is mounted on a GV aperture plate, weighs 3.2 kg and draws less than 20W from 120 VAC, 60 Hz."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
