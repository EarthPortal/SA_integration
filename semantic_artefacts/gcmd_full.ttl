generated by: null); 
""" ;
    skos:definition "Rocks  that have been abraded, pitted, etched, grooved, or polished by wind-driven sand or ice crystals. These geomorphic features are most typically found in arid environments where there is little vegetation to interfere with aeolian particle transport, where there are frequently strong winds, and where there is a steady but not overwhelming supply of sand."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "VENTIFACTS"@en ;
    gcmd:reference [ gcmd:text "PhysicalGeography.net"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/2c1cf609-c70d-4811-8514-3ca45a8bb380> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f> ;
    skos:definition """Roundworms are mostly worm-like and unsegmented, with an external cuticle,
a pseudocoelom between body wall and gut, an anus and complex nervous
system but not circulatory system.  They are mostly free living bottom
dwellers in marine and freshwater environments and in the soil."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "ROUNDWORMS"@en ;
