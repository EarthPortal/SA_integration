    skos:definition """Characteristics of the Imaging Instrument CCD Camera:
Spectral bands:
0,51 - 0,73 µm (pan)
0,45 - 0,52 µm (blue)
0,52 - 0,59 µm (green)
0,63 - 0,69 µm (red)
0,77 - 0,89 µm (near infrared)
Field of view:  8,3º
Spatial resolution: 20 x 20 m
Swath width: 113 km
Mirror pointing capability: ±32º
Temporal resolution: 26 days nadir view (3 days revisit)
RF carrier frequency: 8103 MHz and 8321 MHz
Image data bit rate: 2 x 53 Mbit/s
EIRP: 43 dBm


Group: Instrument_Details
   Entry_ID: CCD (CBERS 2)
   Group: Instrument_Identification
      Instrument_Category: Earth Remote Sensing Instruments
      Instrument_Class: Passive Remote Sensing
      Instrument_Type: Photon/Optical Detectors
      Instrument_Subtype: Cameras
      Short_Name: CCD (CBERS 2)
   End_Group
   Group: Associated_Platforms
      Short_Name: CBERS-2
   End_Group
   Online_Resource: http://www.cresda.com/n16/n92006/n92066/n98575/index.html
   Online_Resource: http://www.satimagingcorp.com/satellite-sensors/cbers-2.html
   Creation_Date: 2011-08-22
End_Group"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "CCD (CBERS 2)"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "CCD (CBERS 2)"@en ] .

