        <https://gcmd.earthdata.nasa.gov/kms/concept/75d48be5-2e6d-442f-9e97-0146706f7261>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/a2069a17-e6be-49f4-a796-72aede755493>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/a7852052-09a6-4c48-b720-9dfb086df3db>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/bc69ef64-c468-4e8a-9a41-3b421e79cc90>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/ceb704ea-58eb-441a-8f86-9d2d7017240c>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/dbfa9c1a-1853-4c48-8adf-f51ca6715c43> ;
    skos:prefLabel "Meteosat"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Meteosat Operational Programme"@en ] ;
    gcmd:reference [ gcmd:text "https://www.eumetsat.int/our-satellites/meteosat-series"@en ] .

