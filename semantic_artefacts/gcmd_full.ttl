<https://gcmd.earthdata.nasa.gov/kms/concept/77cbdebf-eddf-42b5-8603-e939eccd1780> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/45325a01-2522-48d3-bffa-0edf1a934d48> ;
    skos:definition """Lake level fluctuations can provide important evidence for paleoclimatic
conditions, particulary in arid and semiarid areas. Lake levels are
particularly sensitive to changes in hydrologic balance due to climatic
fluctuations. Lakes may develop and expand if there is an abundance of
precipitation and will recede and even dry up (due to evaporation) during
prolonged droughts. Lake sediment cores are often drilled to provide
stratigraphic clues to past climate conditions."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "LAKE LEVELS"@en ;
    gcmd:reference [ gcmd:text """Bradley, R.S. 1999. Paleoclimatology: Reconstructing Climates of the
Quaternary, 2nd edition. Harcourt Academic Press (especially Chapter 7.6)."""@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/77d3b352-f1e4-4080-b2d3-b8fc64469bdf> a skos:Concept ;
