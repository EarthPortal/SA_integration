<https://gcmd.earthdata.nasa.gov/kms/concept/77f6de85-0628-4659-bfe1-9172ba7b19ef> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/78c70202-ab05-40d6-90db-563be2a8dc90> ;
    skos:definition """Precipitation samples are collected with wet/dry collectors or
bulk samplers. The wet/dry collector is the preferred
precipitation sampler and consists of a bucket that is open only
during periods of wet (rainfall, snow, etc.)
precipitation. During dry periods the sample bucket is covered,
thus excluding dry-fall precipitation from the sample.

[Summary provided by USGS]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "WET/DRY PRECIPITATION SAMPLERS"@en .

