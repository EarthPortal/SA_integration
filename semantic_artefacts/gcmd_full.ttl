   End_Group
   Group: Associated_Platforms
      Short_Name: THEMIS
   End_Group
   Online_Resource: http://www.nasa.gov/mission_pages/themis/spacecraft/SCM.html
   Online_Resource: http://themis.ssl.berkeley.edu/instrument_scm.shtml
   Sample_Image: http://www.nasa.gov/images/content/168039main_SCM_ETU_1_med.jpg
   Creation_Date: 2008-07-18
   Group: Instrument_Logistics
      Instrument_Owner: CETP (France)
      Instrument_Owner: NASA (USA)
   End_Group
End_Group"""@en ;
