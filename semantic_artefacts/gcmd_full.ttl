<https://gcmd.earthdata.nasa.gov/kms/concept/3d040403-e6ab-4e42-b54a-14cce4033f6e> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/6c5ca722-0bc7-4ccd-ad24-39b9d8710140> ;
    skos:changeNote """2021-08-04 17:15:40.0 [sritz]  
insert AltLabel (id: null
category: primary
text: TOGA RADAR
language code: en); 
""" ;
    skos:definition """The Tropical Ocean Global Atmosphere Coupled Ocean Atmosphere Response
Experiment (TOGA COARE) provided the opportunity to observe tropical
precipitation systems in the Western Pacific Ocean. Previous studies
have shown that the driving force of global circulation is the result
of latent heat released during the formation of tropical precipitation
(Simpson et al. 1988). One of the goals of TOGA COARE was to determine
and understand the development and interactions of precipitation in
the tropical Pacific Ocean.

Additional information available at
"http://www.iihr.uiowa.edu/projects/rrresearch/\""""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "TOGA RADAR"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "TOGA RADAR"@en ] .

