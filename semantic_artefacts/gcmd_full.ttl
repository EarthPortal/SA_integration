    skos:definition """A colorless gas, made up of two atoms of univalent nitrogen and one atom
of oxygen, N2O. In the ocean, it is formed as a minor product of
bacterial nitrification and denitrification."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "NITROUS OXIDE"@en ;
    gcmd:reference [ gcmd:text """Adapted from: Libes. S. 1992. Introduction to Marine Biogeochemistry. John
Wiley and Sons. p. 434."""@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/d1c4be34-1053-42c5-bc81-bfdcb6b27567> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/563f30c8-43f8-48be-b649-4b548f877fa4> ;
    skos:changeNote """2019-02-15 16:19:18.0 [mmorahan]  
