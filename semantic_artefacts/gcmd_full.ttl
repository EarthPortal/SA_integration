insert Definition (id: null
text: The timeseries are calculated from the Kaplan SST dataset which is updated monthly. It is basically an index of the N Atlantic temperatures. Time time series are created; a smoothed version and an unsmoothed version. In addition, two files starting at 1948 are produced to be used in the Correlation webpages.
language code: en); 
""",
        """2020-02-14 14:14:12.0 [tstevens] Remove Concepts 
delete narrower relation (null); 
