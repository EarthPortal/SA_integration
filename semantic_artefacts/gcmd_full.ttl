      Long_Name: GRACE SuperSTAR Accelerometer
   End_Group
   Group: Associated_Platforms
      Short_Name: GRACE
   End_Group
   Group: Spectral_Frequency_Information
      Wavelength_Keyword: Radio
      Spectral_Frequency_Coverage_Range: 10-3 ms-2
