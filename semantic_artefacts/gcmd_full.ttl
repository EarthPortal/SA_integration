   Group: Platform_Logistics
      Launch_Date: 1982-04-10
      Primary_Sponsor: India
   End_Group
End_Group); 
update Definition (https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1982-031A); 
delete Resource (null); 
""" ;
