    skos:prefLabel "APR-2"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Second Generation Airborne Precipitation Radar"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/32ffe87f-c0f0-4398-9a6a-755d7f87a5ff> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/6a2a2417-1a9c-4767-bffd-6b99f9747bab> ;
    skos:definition """Sporozoans are one of four categories of protozoans. Sporozoan is an
informal name for parasitic protistans that complete part of the life
cycle inside specific cells of host organisms.  Many sporozoans cause
human diseases.  Plasmodium causes malaria while Cryptosporidium strains
which contaminate many water supplies can cause serious intestinal
disorders."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "SPOROZOANS"@en ;
    gcmd:reference [ gcmd:text """Starr, C. and R. Taggart.  1998.  Biology: the unity and diversity of life.
Wadsworth Publishing Company. Belmont, California."""@en ] .

