   End_Group
   Group: Spectral_Frequency_Information
      Wavelength_Keyword: Ultraviolet
      Number_Channels: 4
      Spectral_Frequency_Coverage_Range: 17.1 - 30.4 nm
      Spectral_Frequency_Resolution: 2.5 arcsec
   End_Group
   Online_Resource: http://umbra.nascom.nasa.gov/eit/EIT.html#INSTRUMENT
   Sample_Image: http://umbra.nascom.nasa.gov/eit/images/EIT_instrument.gif
   Group: Instrument_Logistics
      Instrument_Start_Date: 1995-12-02
      Instrument_Owner: NASA/GSFC
   End_Group
End_Group"""@en ;
