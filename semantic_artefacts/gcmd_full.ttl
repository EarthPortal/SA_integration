insert Definition (id: null
text: A crack in an ice sheet or glacier (compare to crevice, which is in rock). Crevasses often have vertical or near-vertical walls, which can then melt and create seracs, arches, etc.; these walls sometimes expose layers that represent the glacier's stratigraphy.
language code: en); 
""",
        """2024-10-29 09:26:12.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: e0d85cf0-b477-47df-a067-18e28a3e228f
relationship type: null
relationship value: null
generated by: null); 
""" ;
    skos:definition "A crack in an ice sheet or glacier (compare to crevice, which is in rock). Crevasses often have vertical or near-vertical walls, which can then melt and create seracs, arches, etc.; these walls sometimes expose layers that represent the glacier's stratigraphy."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/6ba069ae-8561-44b7-9e59-d645d6bd725f>,
