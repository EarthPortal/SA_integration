    skos:prefLabel "CELIAS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Charge, Element, and Isotope Analysis System"@en ] ;
    gcmd:resource [ gcmd:type "IMAGE" ;
