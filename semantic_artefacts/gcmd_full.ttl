        """2024-05-01 09:00:15.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Block III/IIIF Global Positioning System Satellites A through F
language code: en); 
insert Definition (id: null
text: The GPS space segment consists of a constellation of satellites transmitting radio signals to users. The United States is committed to maintaining the availability of at least 24 operational GPS satellites, 95% of the time. To ensure this commitment, the U.S. Space Force has been flying 31 operational GPS satellites for well over a decade.
language code: en); 
""" ;
    skos:definition "The GPS space segment consists of a constellation of satellites transmitting radio signals to users. The United States is committed to maintaining the availability of at least 24 operational GPS satellites, 95% of the time. To ensure this commitment, the U.S. Space Force has been flying 31 operational GPS satellites for well over a decade."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
