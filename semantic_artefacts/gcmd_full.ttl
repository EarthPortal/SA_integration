<https://gcmd.earthdata.nasa.gov/kms/concept/27d63fe6-9970-46fd-9b22-a58e52efc57b> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/d46a5046-e1c6-4a09-a2f1-db6a21eda611> ;
    skos:definition """Hypochlorous acid (HOCL) is a weak, unstable acid.\r
Hypochlorous acid is also a minor component of the gas-phase inorganic chlorine
budget in the stratosphere. It is formed there largely from reaction of\r
hydroperoxyl radicals (HO2) with chlorine monoxide (ClO) radicals, and from the
hydrolysis of chlorine nitrate on stratospheric aerosols. It is subject to\r
quite rapid photolysis in the sunlit atmosphere."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "HYPOCHLOROUS ACID"@en ;
    gcmd:reference [ gcmd:text """American Meteorological Society Glossary of Meteorology Online:\r
"http://amsglossary.allenpress.com/glossary\""""@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/27d770a5-fd5d-4eca-a1a3-285ed5f35ac2> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/3d25724b-832f-4a61-b0b2-4f2ccecdba94> ;
    skos:changeNote """2019-03-26 14:41:51.0 [sritz] Insert Concept 
add broader relation (NM BARE [27d770a5-fd5d-4eca-a1a3-285ed5f35ac2,368593] - Chemical Meters/Analyzers [3d25724b-832f-4a61-b0b2-4f2ccecdba94,346879]); 
