    skos:definition """Geomagnetic indices are an indicator of geomagntic activity caused by solar\r
events. Typical geomagntic indices are: a, A, Ap, Dst, K, and Kp.   The
A-index,\r
for example, is a daily average composed of 3-hour data points.  Geomagnetic\r
indices can be used in conjunction with solar"wind" data to predict the onset\r
and intensity of geomagnetic storms."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "GEOMAGNETIC INDICES"@en ;
    gcmd:reference [ gcmd:text """NOAA/NGDC Solar-Terrestrial Glossary:\r
http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html"""@en ] .

