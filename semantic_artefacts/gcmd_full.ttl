        """2020-12-22 11:36:43.0 [sritz]  
insert AltLabel (id: null
category: primary
text: Nimbus-E Microwave Spectrometer
language code: en); 
insert Definition (id: null
text: The Nimbus E Microwave Spectrometer (NEMS) was designed primarily to demonstrate the capabilities and limitations of microwave sensors for measuring tropospheric temperature profiles, water vapor abundances, cloud liquid water content, and earth surface temperatures. The NEMS could continuously monitor emitted microwave radiation at frequencies of 22.235, 31.4, 53.65, 54.9 and 58.8 GHz. The three channels near the 5-mm oxygen absorption band were used primarily to determine the atmospheric temperature profiles.
language code: en); 
insert WeightedRelation (id: null
related concept uuid: 955e7643-bd77-44aa-ba05-f7b841ce582b
relationship type: null
relationship value: null
generated by: null); 
""",
