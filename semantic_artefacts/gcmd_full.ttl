<https://gcmd.earthdata.nasa.gov/kms/concept/146a0a0b-1b42-41a6-b1f7-a27615b006a0> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/d46a5046-e1c6-4a09-a2f1-db6a21eda611> ;
    skos:definition """A toxic, colorless, strongly acidic gas (HCl) that dissolves readily in water\r
to form hydrochloric acid. \r
In the troposphere, hydrochloric acid can be produced from the reaction of\r
nitric acid or sulfuric acid with sea-salt particles (NaCl). It is also\r
involved in the formation of ammonium chloride aerosol. HCl is also the most\r
abundant form of chlorine in an inorganic compound found in the stratosphere.\r
Produced there predominantly from the reaction of Cl atoms with methane and\r
molecular hydrogen, it acts as a temporary, relatively unreactive reservoir\r
species for chlorine."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "HYDROGEN CHLORIDE"@en ;
    gcmd:reference [ gcmd:text """American Meteorological Society Glossary of Meteorology Online:\r
"http://amsglossary.allenpress.com/glossary\""""@en ] .

