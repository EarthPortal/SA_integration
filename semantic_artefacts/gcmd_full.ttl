    skos:changeNote """2020-04-16 07:40:20.0 [tstevens] Insert Concept 
add broader relation (TOGA [6684e131-f3d0-4db9-8efc-1e19083b9e2a,559969] - Chemical Meters/Analyzers [3d25724b-832f-4a61-b0b2-4f2ccecdba94,543779]); 
""",
        """2020-04-16 07:41:18.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Trace Organic Gas Analyzer
language code: en); 
insert Definition (id: null
text: TOGA provides near-continuous real-time atmospheric mixing ratios of an extensive and growing list of volatile organic compounds (VOCs) in the C2-C10 molecular structure range. The list includes alkanes, alkenes, chlorofluorocarbons, halons, nitrates, nitriles, sulfides, alcohols, ketones, aldehydes and ethers. Typically, a subset of some 60-70 unique trace gases are measured, with sufficient sensitivity to measure trace species in the remote background atmosphere and dynamic range to measure in highly polluted regions.
language code: en); 
""" ;
    skos:definition "TOGA provides near-continuous real-time atmospheric mixing ratios of an extensive and growing list of volatile organic compounds (VOCs) in the C2-C10 molecular structure range. The list includes alkanes, alkenes, chlorofluorocarbons, halons, nitrates, nitriles, sulfides, alcohols, ketones, aldehydes and ethers. Typically, a subset of some 60-70 unique trace gases are measured, with sufficient sensitivity to measure trace species in the remote background atmosphere and dynamic range to measure in highly polluted regions."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "TOGA"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Trace Organic Gas Analyzer"@en ] ;
    gcmd:reference [ gcmd:text "https://www2.acom.ucar.edu/voc-measurements/measurement-instrumentation"@en ] .

