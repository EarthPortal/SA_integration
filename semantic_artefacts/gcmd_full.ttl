    skos:changeNote """2021-06-08 08:10:30.0 [tstevens] Insert Concept 
add broader relation (NOAA Delaware II [15f524d9-5155-466a-9d46-364d977bd864,635340] - SHIPS [82a67b12-e99d-4c90-8a6a-a6f79d4c3c7b,626109]); 
""",
        """2021-06-08 08:11:27.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: NOAA Ship Delaware II
language code: en); 
insert Definition (id: null
text: NOAA Ship Delaware II conducted fishery and living marine resource research in support of the NOAA National Marine Fisheries Service's Northeast Fisheries Science Center. The ship's normal operating area was the Gulf of Maine, Georges Bank, and the continental shelf and slope from Southern New England to Cape Hatteras, North Carolina. Typical assessment work included groundfish assessment surveys and Marine Resources Monitoring, Assessment and Prediction surveys. Research conducted by Delaware II provided an understanding of the physical and biological processes that control year-class strength of key economical fish species.
language code: en); 
""",
        """2021-11-18 09:34:47.0 [tstevens] Move Concepts 
delete broader relation (null); 
add broader relation (NOAA Delaware II [15f524d9-5155-466a-9d46-364d977bd864,826000] - Surface [59b97a6c-385e-40a2-8422-ecbdb6023c4c,835900]); 
""" ;
    skos:definition "NOAA Ship Delaware II conducted fishery and living marine resource research in support of the NOAA National Marine Fisheries Service's Northeast Fisheries Science Center. The ship's normal operating area was the Gulf of Maine, Georges Bank, and the continental shelf and slope from Southern New England to Cape Hatteras, North Carolina. Typical assessment work included groundfish assessment surveys and Marine Resources Monitoring, Assessment and Prediction surveys. Research conducted by Delaware II provided an understanding of the physical and biological processes that control year-class strength of key economical fish species."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
    skos:prefLabel "NOAA Delaware II"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "NOAA Ship Delaware II"@en ] ;
    gcmd:reference [ gcmd:text "https://www.omao.noaa.gov/learn/marine-operations/ships/decommissioned/delaware-ii"@en ] .

