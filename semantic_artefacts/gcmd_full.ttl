        <https://gcmd.earthdata.nasa.gov/kms/concept/fadd59e2-e1d2-44f6-9e41-0589eb953198>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/fde8a54a-8aaa-45fd-bb66-3105e4c57102> ;
    skos:prefLabel "CRYOSPHERIC INDICATORS"@en ;
    gcmd:reference [ gcmd:text "https://climate.copernicus.eu/climate-indicators/cryosphere"@en ] .

