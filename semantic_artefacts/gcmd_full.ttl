    skos:definition """An anticyclone is a dome of air that exerts relatively high
atmospheric pressure compared with the surrounding air at a given level. A
cyclone is a weather system characterised by relatively low surface air
pressure at a given level and a closed cyclonic wind circulation."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "ANTICYCLONES/CYCLONES"@en ;
    gcmd:reference [ gcmd:text "Glossary of Weather and Climate, American Meteorological Society, 1996."@en ] .

