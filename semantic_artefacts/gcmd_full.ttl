   Sample_Image: https://remus.jpl.nasa.gov/jpeg/tes.jpg
   Creation_Date: 2007-05-21
   Group: Instrument_Logistics
      Data_Rate: 4.5 MBPS
      Instrument_Owner: USA/NASA
   End_Group
End_Group); 
update Resource (image); 
update Resource (https://remus.jpl.nasa.gov/jpeg/tes.jpg); 
""",
