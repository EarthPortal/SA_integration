insert AltLabel (id: null
category: primary
text: LICOR LEAF AREA METER
language code: en); 
""" ;
    skos:definition """The Li-Cor LI-3100 Leaf Area Meter provides a rapid, easy-to-use
system for precise measurements of both large and small
objects. Capability for either 1 mm2 or 0.1 mm2 area resolution
is provided on the same instrument. Samples are rapidly measured
by placing them on a moving transparent belt and allowing them
to pass through the LI-3100. An adjustable press roller flattens
the curled leaves and feeds them properly between the
transparent belts. The 3000A-01 Readout Console can be connected
to the LI-3100 for additional data storage and output
capabilities.

Additional information available at
"http://www.glenspectra.co.uk/glen/licor/li3100.htm"

[Summary provided by Glen Spectra]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "LICOR LEAF AREA METER"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "LICOR LEAF AREA METER"@en ] .

