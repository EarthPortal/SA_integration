      Short_Name: OSO-7
      Long_Name: Orbiting Solar Observatory-7
   End_Group
   Group: Synonymous_Platform_Names
      Short_Name: OSO-7
   End_Group
   Group: Platform_Associated_Instruments
      Short_Name: GAMMA RADIATION DETECTOR
   End_Group
   Group: Orbit
      Orbit_Inclination: 33.1 degrees
      Perigee: 321 km
      Apogee: 572 km
   End_Group
   Creation_Date: 2007-12-14
   Online_Resource: http://heasarc.gsfc.nasa.gov/docs/oso7/oso7.html
   Sample_Image: http://heasarc.gsfc.nasa.gov/Images/oso/oso7_flight.gif
   Group: Platform_Logistics
      Launch_Date: 1971-09-29
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
