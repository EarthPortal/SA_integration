        <https://gcmd.earthdata.nasa.gov/kms/concept/db2063ed-c27a-41e2-9e40-9f2f7e63f94b> ;
    skos:prefLabel "Air-based Platforms"@en ;
    gcmd:reference [ gcmd:text "https://www2.geog.soton.ac.uk/users/trevesr/obs/rseo/index.html"@en ] .

