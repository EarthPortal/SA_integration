        """2020-09-28 09:05:31.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Hydroinnova COSMOS Soil Moisture Rover
language code: en); 
insert Definition (id: null
text: Hydroinnova offers several configurations of the Cosmic-Ray Soil Moisture Probe. The baseline system is a complete data logging and telemetry solution which includes integrated barometric pressure, humidity, temperature sensors. Our datalogger will also support common external sensors including capacitance probes, water content reflectometers, tipping bucket rain gauges and many other analog sensors commonly used in environmental measurements.
language code: en); 
""" ;
    skos:definition "Hydroinnova offers several configurations of the Cosmic-Ray Soil Moisture Probe. The baseline system is a complete data logging and telemetry solution which includes integrated barometric pressure, humidity, temperature sensors. Our datalogger will also support common external sensors including capacitance probes, water content reflectometers, tipping bucket rain gauges and many other analog sensors commonly used in environmental measurements."@en ;
