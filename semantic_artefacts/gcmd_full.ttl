    gcmd:reference [ gcmd:text """Nemani, R.R., L.L.Pierce, and S.W. Running. (1993). Developing\r
satellite-derived estimates of surface moisture status. <i>Journal of\r
Applied Meteorology</i>,32: 548-557.\r
"http://www.forestry.umt.edu/rsl/smi/smi_overview.htm\""""@en ] .

