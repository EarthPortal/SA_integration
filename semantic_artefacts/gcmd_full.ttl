   Sample_Image: http://science.ksc.nasa.gov/history/gemini/gemini-3/gemini-3-patch-small.gif
   Group: Platform_Logistics
      Launch_Date: 1965-03-23
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
