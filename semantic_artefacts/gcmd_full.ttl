    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "PLANETARY BOUNDARY LAYER HEIGHT"@en ;
    gcmd:reference [ gcmd:text "Glossary of Weather and Climate, American Meteorological Society, 1996."@en ] .

