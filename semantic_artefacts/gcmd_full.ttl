<https://gcmd.earthdata.nasa.gov/kms/concept/ed7c506e-b18e-4a93-ac03-4bdfe119b72f> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9> ;
    skos:definition """Nitrogen is a plant nutrient that is a component of proteins, nucleic
acids, coenzymes, and chlorophylls.  Plants that are deficient in nitrogen
have stunted growth, and light-green older leaves."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
