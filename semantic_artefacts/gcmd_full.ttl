   Creation_Date: 2007-05-08
   Group: Instrument_Logistics
      Data_Rate: 93.2 Kbps
      Instrument_Owner: JAPAN/JAXA
      Instrument_Owner: Communications Research Laboratory - Japan
   End_Group
End_Group); 
update Resource (image); 
