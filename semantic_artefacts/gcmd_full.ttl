   End_Group
   Group: Orbit
      Orbit_Inclination: 28.78 degrees
      Perigee: 243 km
      Apogee: 310 km
   End_Group
   Creation_Date: 2007-01-23
   Online_Resource: http://www.astronautix.com/flights/gemini12.htm
   Sample_Image: http://www.astronautix.com/graphics/0/10074584.jpg
   Group: Platform_Logistics
      Launch_Date: 1966-11-11
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
