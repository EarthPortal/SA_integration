<https://gcmd.earthdata.nasa.gov/kms/concept/f0e787fa-61e0-4b24-9aba-68c554f5dadf> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/ba25756b-6326-4746-a20d-63db582a5f3f> ;
    skos:changeNote """2022-10-06 08:34:42.0 [tstevens] Insert Concept 
add broader relation (SR50A [f0e787fa-61e0-4b24-9aba-68c554f5dadf,1070175] - Acoustic Sounders [ba25756b-6326-4746-a20d-63db582a5f3f,1062257]); 
""",
        """2022-10-06 08:35:51.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Campbell SR50A Sonic Distance Sensor
language code: en); 
insert Definition (id: null
text: The SR50A Sonic Ranging Sensor measures the distance from the sensor to a target. The most common applications are measuring snow depths and water levels. The sensor is based on a 50 kHz (Ultrasonic) electrostatic transducer. The SR50A determines the distance to a target by sending out ultrasonic pulses and listening for the returning echoes that are reflected from the target. The time from transmissions to return of an echo is the basis for obtaining the distance measurement.
language code: en); 
""" ;
    skos:definition "The SR50A Sonic Ranging Sensor measures the distance from the sensor to a target. The most common applications are measuring snow depths and water levels. The sensor is based on a 50 kHz (Ultrasonic) electrostatic transducer. The SR50A determines the distance to a target by sending out ultrasonic pulses and listening for the returning echoes that are reflected from the target. The time from transmissions to return of an echo is the basis for obtaining the distance measurement."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "SR50A"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Campbell SR50A Sonic Distance Sensor"@en ] ;
    gcmd:reference [ gcmd:text "https://s.campbellsci.com/documents/cr/manuals/sr50a.pdf"@en ] .

