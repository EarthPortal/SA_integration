        """2021-08-06 08:49:42.0 [mmorahan]  
insert AltLabel (id: null
category: primary
text: Langmuir Probe
language code: en); 
insert Definition (id: null
text: The Langmuir Probe, realized by the Center for Space Science and Applied Research of the Chinese Academy of Science, allows to:

- monitor the global parameters of the ionosphere in situ

- study the coupling between lithosphere and ionosphere before, during and after earthquakes.

The LP consists of a pair of spherical Langmuir Probes with diameters of 5 cm and 1 cm, respectively, installed at the tip of booms 50 cm long. The LP has been tested in an Electronics test facility for an electronics calibration and in the INAF-IAPS Plasma Chamber.
language code: en); 
insert WeightedRelation (id: null
related concept uuid: 52ae802c-b2fd-4548-aefd-ec4e4325b803
relationship type: null
relationship value: null
generated by: null); 
""" ;
    skos:definition """The Langmuir Probe, realized by the Center for Space Science and Applied Research of the Chinese Academy of Science, allows to:

- monitor the global parameters of the ionosphere in situ

- study the coupling between lithosphere and ionosphere before, during and after earthquakes.

The LP consists of a pair of spherical Langmuir Probes with diameters of 5 cm and 1 cm, respectively, installed at the tip of booms 50 cm long. The LP has been tested in an Electronics test facility for an electronics calibration and in the INAF-IAPS Plasma Chamber."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "Zhangheng LAP"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Langmuir Probe"@en ] ;
    gcmd:reference [ gcmd:text "https://directory.eoportal.org/web/eoportal/satellite-missions/content/-/article/cses-zhangheng-1"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/6fce447f-7097-48ca-8094-60bc6ffc9eae> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/bb175474-5e70-47be-8e1f-8dcd7563cc5b> ;
    skos:definition """The MAM magnetic field instrument on EQUATOR-S consists of three-axes flux-gate
magnetometers, one mounted at the end of a 1.8-m boom, the other 50 cm further
inboard, to reduce (and determine) the amount of interference from the
spacecraft. The sampling rate is 128 vectors/s when only one of the
magnetometers is utilized, and 64 vectors/s when both are utilized. Resolution
is 16 bits, and ranges can be selected (automatically or manually) in steps of
4, between 250 and 64000 nT.
See:
http://www.mpe-garching.mpg.de/EQS/eq-s-instruments.html"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "MAM"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Magnetic Field Instrument"@en ] .

