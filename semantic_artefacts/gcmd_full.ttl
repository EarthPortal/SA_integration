insert WeightedRelation (id: null
related concept uuid: 4f0f52fb-b272-49c6-9425-690d9285c380
relationship type: null
relationship value: null
generated by: null); 
""" ;
    skos:definition "Refers to the the gradual uplift following rapid erosional removal of material from a mountain range. The land rises as a result of the removal of the weight. Another example of isostatic uplift is post-glacial rebound following the melting of continental glaciers and ice sheets."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
