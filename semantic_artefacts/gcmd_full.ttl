   End_Group
   Group: Orbit
      Orbit_Inclination: 32.8 degrees
      Period: 95.8 min
      Perigee: 546 km
      Apogee: 570 km
   End_Group
   Creation_Date: 2007-12-14
   Online_Resource: http://heasarc.gsfc.nasa.gov/docs/heasarc/missions/oso3.html
   Sample_Image: http://heasarc.gsfc.nasa.gov/Images/oso/oso3.gif
   Group: Platform_Logistics
      Launch_Date: 1967-03-08
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
