      Wavelength_Keyword: INFRARED > THERMAL
      Number_Channels: 1
      Spectral_Frequency_Coverage_Range: 11.50 - 12.50 µm
   End_Group
   Online_Resource: http://noaasis.noaa.gov/NOAASIS/ml/imager.html
   Online_Resource: http://www.oso.noaa.gov/goes/goes-calibration/goes-imager-srfs.htm
   Group: Instrument_Logistics
