<https://gcmd.earthdata.nasa.gov/kms/concept/d3c5e3e3-97bf-4e74-9f8d-523dce5f9270> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/8fb66b46-b998-4412-a541-d2acabdf484b> ;
    skos:definition """Indicator species are defined as species which can provide information on\r
ecological changes and give early warning signals regarding ecosystem processes
in site-specific conditions due to their sensitive reactions to them. They can\r
also be called sentinel species, indicator organisms, biological indicators\r
("bioindicators"), biological markers, or environmental indicators. The latter\r
three expressions do not necessarily refer to species but also to other\r
environmental elements which can indicate environmental changes."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "INDICATOR SPECIES"@en ;
    gcmd:reference [ gcmd:text """Allaby, Michael, 1994, The Concise Oxford Dictionary of Ecology. See also the\r
Global Terrestrial Observing System (GTOS) Terrestrial Ecosystem Monitoring\r
Sites (TEMS) database: "http://www.fao.org/gtos/tems/index.jsp\""""@en ] .

