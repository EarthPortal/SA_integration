        <https://gcmd.earthdata.nasa.gov/kms/concept/e89e331c-ca8e-4c25-be34-c81017bd019f>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/fb890034-3ae6-4c91-941c-ae1483a13528> ;
    skos:prefLabel "ACCUMULATED CYCLONE ENERGY"@en ;
