generated by: null); 
insert WeightedRelation (id: null
related concept uuid: 29564e60-e0d6-4d5d-9999-97b9cd16a034
relationship type: null
relationship value: null
generated by: null); 
insert WeightedRelation (id: null
related concept uuid: a790e30f-5a13-4188-befb-2647a884034b
relationship type: null
