<https://gcmd.earthdata.nasa.gov/kms/concept/b2800856-f1e3-41aa-bdc4-75e9cd626d3f> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/099ab1ae-f4d2-48cc-be2f-86bd58ffc4ca> ;
    skos:definition """A continuous sheet of land ice that covers a very large area and moves outward\r
in many directions. This type of ice mass is so thick as to mask the land\r
surface contours, in contrast to the smaller and thinner highland ice. The\r
continental glacier of Greenland is sometimes called the Inland Ice. This term\r
is often used to describe the great ice masses that characterized the ice ages."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "ICE SHEETS"@en ;
    gcmd:reference [ gcmd:text """American Meteorological Society Glossary of Meteorology.
"http://amsglossary.allenpress.com/glossary/\""""@en ] .

