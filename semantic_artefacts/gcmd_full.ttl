        <https://gcmd.earthdata.nasa.gov/kms/concept/cbdf4f94-efc6-4965-a329-5df989a9a211> ;
    skos:prefLabel "CNIDARIANS"@en ;
    gcmd:reference [ gcmd:text """http://www.oceaninn.com/guides/cnidarians.htm\r
