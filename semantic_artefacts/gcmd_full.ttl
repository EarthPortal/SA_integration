    skos:definition """The Antarctic Oscillation (AAO) is the dominant pattern of\r
non-seasonal tropospheric circulation variations south of 20S, and it\r
is characterized by pressure anomalies of one sign centered in the\r
Antarctic and anomalies of the opposite sign centered about\r
40-50S. The AAO is also referred to as the Southern Annular Mode\r
(SAM). There is a Northern Hemisphere analog to the AAO, and it is\r
called the Arctic Oscillation (or Northern Annular Mode)."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "ANTARCTIC OSCILLATION"@en ;
    gcmd:reference [ gcmd:text """Joint Institute for the Study of the Atmosphere and Ocean, U. Washington\r
http://www.jisao.washington.edu/data/aao/"""@en ] .

