   End_Group
   Group: Spectral_Frequency_Information
      Wavelength_Keyword: Infrared > Reflected
      Spectral_Frequency_Coverage_Range: 10.5 - 12.5 micrometers
   End_Group
   Online_Resource: http://nsidc.org/data/docs/daac/seasat_platform.gd.html
   Creation_Date: 2009-03-02
   Group: Instrument_Logistics
      Instrument_Start_Date: 1978-07-04
      Instrument_Stop_Date: 1978-08-27
      Instrument_Owner: USA/NASA
   End_Group
End_Group"""@en ;
