insert Definition (id: null
text: Instruments that monitor and records/logs changes in conditions over time. They can be single, stand-alone units or consist of multiple channels. Most stand-alone units are battery-powered, allowing them to record while in transit and for extended periods of time.
language code: en); 
""",
