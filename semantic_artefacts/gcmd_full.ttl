category: primary
text: TETHERSONDES
language code: en); 
""" ;
    skos:definition """TETHERSONDES are radiosondes attached to a fixed or tethered
balloon that is usually larger than the balloons used for
upper-air soundings; the tether limits the sounding to the
boundary layer and the radiosonde moves up and down the tether
to get multiple, high resolution profiles of the boundary layer."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "TETHERSONDES"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "TETHERSONDES"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/f0aac4fb-b886-4333-a947-3fede8da1f5b> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/46238695-5577-4fad-91bf-0a2fdf8a9b19> ;
    skos:definition """The Airborne Tunable Laser Absorption Spectrometer (ATLAS) uses
a tunable laser to detect a target gas such as N2O, methane,
carbon monoxide, or ozone. The laser source is tuned to an
individual roto-vibrational line in an infrared absorption band
of the target gas, and is frequency modulated at 2 kHz. The
instrument detects the infrared target gas by measuring the
fractional absorption of the infrared beam from the tunable
diode laser.

Additional information available at
"http://www.dfrc.nasa.gov/Research/AirSci/ER-2/pi_inst.html"

[Summary provided by NASA]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "ATLAS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Airborne Tunable Laser Absorption Spectrometer"@en ] .

