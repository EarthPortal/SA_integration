<https://gcmd.earthdata.nasa.gov/kms/concept/bde65cfd-faec-4656-bc27-22dfe30912b7> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/b80a242d-d5f5-4a5f-976c-6f6fe2ab6b2c> ;
    skos:definition """COS, a gas that is very stable and unreactive in the troposphere, but, it\r
is thought, photolyzes to form carbon monoxide, CO, and sulfur, S, in\r
the stratosphere. Through stratospheric chemical reactions, the sulfur\r
atoms are converted to SO2 and H2SO4 which form sulfate aerosol, cloud\r
condensation nuclei, but which eventually settles into the troposphere and\r
reacts to form sulfuric acid, a component in acid rain. The major\r
biospheric sources of COS are thought to be biological. [Analytical\r
Chemistry; v 65; pages 976-982; 1993.] [Atmospheric Chemical Compounds:\r
Sources, Occurrence, and Bioassay; Graedel, Hawkins, Claxton; page 513;\r
1986; Academic Press; Orlando.]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "CARBONYL SULFIDE"@en ;
    gcmd:reference [ gcmd:text """Atmospheric and Air Chemistry Glossary from the Sam Houston State University.\r
"http://www.shsu.edu/~chemistry/Glossary/glos.html\""""@en ] .

