    skos:prefLabel "RNA"@en ;
    gcmd:reference [ gcmd:text """https://www.genome.gov/genetics-glossary/RNA-Ribonucleic-Acid
https://toolkit.ncats.nih.gov/glossary/rna-transcript/"""@en ] .

