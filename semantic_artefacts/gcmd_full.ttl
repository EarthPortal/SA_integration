    skos:changeNote """2013-12-13 15:31:03.0 [saritz] Insert Concept 
add broader relation (METEOSAT-10 [01ee202c-22c5-442d-b4fd-65f424057ea3,106033] - METEOSAT [28eac19a-5500-4a21-af30-ab7a364ff8d0,73589]); 
""" ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
    skos:prefLabel "METEOSAT-10"@en .

<https://gcmd.earthdata.nasa.gov/kms/concept/020585ff-91fb-421b-ba24-305d657c2231> a skos:Concept ;
