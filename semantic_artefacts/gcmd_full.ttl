""" ;
    skos:definition "Monteith (1964) developed a modified version of the Penman equation in which biophysics was introduced through a surface or canopy resistance – the now well-known Penman–Monteith combination equation – that allowed for vegetation control on transpiration rates."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
    skos:prefLabel "Penman-Monteith"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Penman-Monteith Model with Enhanced Surface Resistance Parameterization"@en ] ;
    gcmd:reference [ gcmd:text "https://www.sciencedirect.com/science/article/pii/S0034425710003251?via%3Dihub#bbb0430"@en ] .

