<https://gcmd.earthdata.nasa.gov/kms/concept/5b12e8dc-d093-47f5-b041-d8fb93bbe458> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/4190ebdc-e89a-4f3f-bc74-b2af4c68d009> ;
    skos:definition """A Dropwindsonde is an instrument package that contains a
temperature sensor, a moisture sensor (hygrometer) and a GPS
receiver that determines the position of the package in time and
3 dimensional space. Upon release, the dropwindsonde transmits
data to the releasing aircraft (DC-8, WC-130, WP-3) where the
data is collected and saved. When subsequently analysed, the
resultant sounding yields temperature, dew point and wind speed
observed by the instrument.

[Source: NASA]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "DROPWINDSONDES"@en .

