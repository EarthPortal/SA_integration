<https://gcmd.earthdata.nasa.gov/kms/concept/ac4ef2f4-6dbb-4ae2-b78e-4f016f7cb6d3> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/271601ce-3e85-4090-b70d-d28a70095c2d> ;
    skos:definition """An Optical Rain Gauge (ORG) is a sensitive instrument for
measuring precipitation. Precipitation is measured by detecting
the optical scintillation induced by drops falling through an
infrared optical beam. By detecting the intensity of the
scintillations that are characteristics of precipitation, the
actual rainfall rate can be estimated. This instrument provides
rain accuracy of 5% and rain resolution of 0.001 mm .

[Source: National MST Radar Facility]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "ORG"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Optical Rain Gauge"@en ] .

