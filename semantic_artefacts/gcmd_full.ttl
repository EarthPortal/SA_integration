    skos:definition """IMAGING RIOMETERS are relative ionospheric opacity meters; A
device for measuring and creating a visual image of the
electromagnetic capacity of the ionosphere using the strength of
a cosmic radio source relative to that during minimums of
ionospheric disturbances."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "IMAGING RIOMETERS"@en .

