        <https://gcmd.earthdata.nasa.gov/kms/concept/ec465fa3-b45e-4f0f-8a3b-857f91c8dbed> ;
    skos:prefLabel "Physical Models"@en ;
    gcmd:reference [ gcmd:text "http://www.futura-sciences.us/dico/d/physics-physical-model-50003678/"@en ] .

