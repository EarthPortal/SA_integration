    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Headwall Hyperspectral Camera"@en ] ;
    gcmd:reference [ gcmd:text "https://www.headwallphotonics.com/hyperspectral-sensors"@en ] .

