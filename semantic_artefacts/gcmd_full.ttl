   Online_Resource: http://adsabs.harvard.edu/abs/2004AGUSMSA51A..01F
   Online_Resource: http://www.cosmic.ucar.edu/
   Online_Resource: http://cosmic-io.cosmic.ucar.edu/cdaac/
   Creation_Date: 2009-10-20
   Group: Instrument_Logistics
      Instrument_Owner: DOD/United States Naval Research Laboratory
      Instrument_Owner: NSF/UCAR
   End_Group
End_Group"""@en ;
