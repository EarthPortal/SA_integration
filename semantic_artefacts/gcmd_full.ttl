        """2024-09-30 11:56:57.0 [sritz]  
insert AltLabel (id: null
category: primary
text: Open-Path Ammonia Laser Spectrometer
language code: en); 
insert Definition (id: null
text: Instrumentation: Open-Path Ammonia Laser Spectrometer (OPALS)
OPALS
- open-path avoids adsorption hystereses, phase partitioning
- fast (1 Hz), sensitive (60 pptv Hz-0.5), ±(20% + 0.1 ppbv) accuracy
- wavelength modulation spectroscopy
- Herriott cell w/ 4.5” Al mirrors
- builds upon QCL-based tower/mobile-lab NH3 sensors and open-
path VCSEL hygrometer for NSF G-V
- reference cell for linelocking during icing/hydrometeors
language code: en); 
""" ;
    skos:definition """Instrumentation: Open-Path Ammonia Laser Spectrometer (OPALS)
OPALS
- open-path avoids adsorption hystereses, phase partitioning
- fast (1 Hz), sensitive (60 pptv Hz-0.5), ±(20% + 0.1 ppbv) accuracy
- wavelength modulation spectroscopy
- Herriott cell w/ 4.5” Al mirrors
- builds upon QCL-based tower/mobile-lab NH3 sensors and open-
path VCSEL hygrometer for NSF G-V
- reference cell for linelocking during icing/hydrometeors"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "OPALS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
