    skos:definition "Phylum Chordata. Class Aves. Order Sphenisciformes. Penguins are flightless aquatic birds, with countershaded bodies and evolved wings into flippers."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
