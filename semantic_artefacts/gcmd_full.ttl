        <https://gcmd.earthdata.nasa.gov/kms/concept/fd710ee8-797c-490a-9f90-064a38141f99> ;
    skos:prefLabel "Indian Remote Sensing Satellite (IRS)"@en ;
    gcmd:reference [ gcmd:text "https://directory.eoportal.org/web/eoportal/satellite-missions/i/irs"@en ] .

