    skos:changeNote """2022-03-28 13:39:46.0 [mmorahan] Insert Concept 
add broader relation (CAPI [1f991c5b-ee25-4074-871f-7f0cc015c468,879784] - Imaging Spectrometers/Radiometers [944b7691-af37-4fb4-9393-c114e7997829,871722]); 
""",
        """2022-03-28 13:41:16.0 [mmorahan]  
insert AltLabel (id: null
category: primary
text: Multiple-band Cloud and Aerosol Polarization Imager
language code: en); 
insert Definition (id: null
text: The CAPI (Cloud and Aerosol Polarization Imager) is a multi-band imager which provides radiance measurements in five bands (365-408 nm, 660-685 nm, 862-877 nm, 1360-1390 nm, 1628-1654 nm) from UV to NIR. In order to achieve more information on aerosol size, which has a significant impact on the wavelength dependence of aerosol optical properties, CAPI includes two polarization channels (660-685 nm and 1628-1654 nm) to measure the Stokes parameters.
language code: en); 
""" ;
    skos:definition "The CAPI (Cloud and Aerosol Polarization Imager) is a multi-band imager which provides radiance measurements in five bands (365-408 nm, 660-685 nm, 862-877 nm, 1360-1390 nm, 1628-1654 nm) from UV to NIR. In order to achieve more information on aerosol size, which has a significant impact on the wavelength dependence of aerosol optical properties, CAPI includes two polarization channels (660-685 nm and 1628-1654 nm) to measure the Stokes parameters."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "CAPI"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Multiple-band Cloud and Aerosol Polarization Imager"@en ] ;
    gcmd:reference [ gcmd:text "https://eoportal.org/web/eoportal/satellite-missions/t/tansat"@en ] .

