    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "DOME TEMPERATURE"@en ;
    gcmd:reference [ gcmd:text """EOSDIS IMS Definitions.\r
"http://harp.gsfc.nasa.gov/v0ims/definitions/par_alph.html\""""@en ] .

