    skos:prefLabel "GOES-18"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Geostationary Operational Environmental Satellite 18"@en ] ;
    gcmd:reference [ gcmd:text "https://www.goes-r.gov/, https://www.noaa.gov/news-release/noaas-goes-t-blasts-into-orbit, https://developers.google.com/earth-engine/datasets/tags/goes-18"@en ] .

