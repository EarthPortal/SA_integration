    skos:prefLabel "STRATOCUMULUS"@en ;
    gcmd:reference [ gcmd:text "https://www.metoffice.gov.uk/weather/learn-about/weather/types-of-weather/clouds/low-level-clouds/stratocumulus"@en ] .

