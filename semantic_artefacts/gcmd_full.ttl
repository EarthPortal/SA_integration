    skos:definition """An Automated Weather System (AWS) provides automatic real-time
wind, precipitation, temperature, dew point and pressure
information to meteorological observers for preparing routine
(every half hourly) and special weather observations reports."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "AWS"@en ;
