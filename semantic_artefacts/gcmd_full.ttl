add broader relation (LI-7000 [53a3754e-12ee-45dc-8766-f422726e0a2a,1830041] - Chemical Meters/Analyzers [3d25724b-832f-4a61-b0b2-4f2ccecdba94,1820980]); 
""",
        """2024-09-27 13:53:49.0 [sritz]  
insert Definition (id: null
text: The LI-7000 is a high speed precision differential infrared gasanalyzer designed for applications requiring high data outputspeeds. A unique, user-cleanable optical cell allows simultaneousmeasurements of CO 2 and H 2 O concentrations in differential andabsolute modes, even when the reference gas concentration isunknown. Data are output via fully linearized Digital-to-Analog-Converters (DACs) with an update rate of 600 Hz, with the RS-232port at speeds up to 50 Hz, or with the USB port at up to 50 Hz.
language code: en); 
""",
        """2024-09-27 13:54:41.0 [sritz]  
update Definition (LI-7000 Instruction Manual, https://licor.app.boxenterprise.net/s/bhbnl1exblejzxi2n2d3); 
""",
        """2024-09-30 11:46:48.0 [sritz]  
insert AltLabel (id: null
category: primary
text: LI-7000 Closed Path CO2/H2O Gas Analyzer
language code: en); 
""" ;
    skos:definition "The LI-7000 is a high speed precision differential infrared gasanalyzer designed for applications requiring high data outputspeeds. A unique, user-cleanable optical cell allows simultaneousmeasurements of CO 2 and H 2 O concentrations in differential andabsolute modes, even when the reference gas concentration isunknown. Data are output via fully linearized Digital-to-Analog-Converters (DACs) with an update rate of 600 Hz, with the RS-232port at speeds up to 50 Hz, or with the USB port at up to 50 Hz."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "LI-7000"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "LI-7000 Closed Path CO2/H2O Gas Analyzer"@en ] ;
    gcmd:reference [ gcmd:text "LI-7000 Instruction Manual, https://licor.app.boxenterprise.net/s/bhbnl1exblejzxi2n2d3"@en ] .

