    skos:changeNote """2020-06-18 13:01:36.0 [tstevens] Insert Concept 
add broader relation (GeoJSON [2648d5e0-a8fd-4cd0-8060-0c63e15d3a67,560328] - Granule Data Format [8e770fe1-6e82-43aa-9f8a-75d217d7e6cb,558797]); 
""",
        """2020-06-18 13:02:16.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: JavaScript Object Notation for Geographical Features
language code: en); 
insert Definition (id: null
text: GeoJSON is an open standard format designed for representing simple geographical features, along with their non-spatial attributes. It is based on the JavaScript Object Notation (JSON). The features include points (therefore addresses and locations), line strings (therefore streets, highways and boundaries), polygons (countries, provinces, tracts of land), and multi-part collections of these types. GeoJSON features need not represent entities of the physical world only; mobile routing and navigation apps, for example, might describe their service coverage using GeoJSON.
language code: en); 
""" ;
    skos:definition "GeoJSON is an open standard format designed for representing simple geographical features, along with their non-spatial attributes. It is based on the JavaScript Object Notation (JSON). The features include points (therefore addresses and locations), line strings (therefore streets, highways and boundaries), polygons (countries, provinces, tracts of land), and multi-part collections of these types. GeoJSON features need not represent entities of the physical world only; mobile routing and navigation apps, for example, might describe their service coverage using GeoJSON."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/DataFormat> ;
    skos:prefLabel "GeoJSON"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "JavaScript Object Notation for Geographical Features"@en ] ;
    gcmd:reference [ gcmd:text "https://tools.ietf.org/html/rfc7946"@en ] .

