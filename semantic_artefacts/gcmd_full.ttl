        """2021-05-10 14:15:56.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: Thermo Scientific Model 43i SO2 Analyzer
language code: en); 
insert Definition (id: null
text: Measure SO2 in ambient air up to 100ppm with the Thermo Scientific™ Model 43i SO2 Analyzer, the first gas analyzer to utilize pulsed fluorescence technology to measure SO2. Reflective bandpass filters are less subject to photochemical degradation and more selective in wavelength isolation, resulting in both increased detection specificity and long term stability.
language code: en); 
""" ;
    skos:definition "Measure SO2 in ambient air up to 100ppm with the Thermo Scientific™ Model 43i SO2 Analyzer, the first gas analyzer to utilize pulsed fluorescence technology to measure SO2. Reflective bandpass filters are less subject to photochemical degradation and more selective in wavelength isolation, resulting in both increased detection specificity and long term stability."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
