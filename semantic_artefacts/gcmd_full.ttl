<https://gcmd.earthdata.nasa.gov/kms/concept/adb501c8-3a2f-4c52-acf3-e77816428a92> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/ba25756b-6326-4746-a20d-63db582a5f3f> ;
    skos:definition """The SURFACE ACOUSTIC WAVE HYGROMETER (SAW) SAW hygrometer
measures the amount of water in the atmosphere by detecting
condensation on the surface of a highly sensitive quartz
oscillator.

In flights on the NASA DC8 experimental aircraft, the SAW
hygrometer was shown to be more than ten times faster than
conventional hygrometers in detecting humidity changes in the
atmosphere.

Additional information available at
"http://technology.jpl.nasa.gov/gallery/techGallery/gallery/
 gl_pages/saw.html"

[Summary provided by NASA]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "SAW"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "JPL Surface Acoustic Wave Hygrometer"@en ] .

