   End_Group
   Creation_Date: 2007-11-19
   Online_Resource: http://sputnik.infospace.ru/goms/engl/goms_1.htm
   Group: Platform_Logistics
      Launch_Date: 1994-10-31
      Launch_Site: Baikonur Cosmodrome, Tyuratam, Russia
      Primary_Sponsor: Russia
   End_Group
End_Group"""@en ;
