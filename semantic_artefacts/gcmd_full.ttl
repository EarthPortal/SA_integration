    skos:changeNote """2012-06-25 10:32:11.0 [mpmorahan] Insert Concept 
add narrower relation (NORTHERN OSCILLATION INDEX [77b2422e-ce52-465f-8841-5d04ebe536dc,22999] - NOI [9a43235b-a7b7-4c76-b296-c01799b1f278,39697]); 
""",
        """2012-07-09 12:02:30.0 [mpmorahan]  
insert Definition (id: null
text: The NOI (extratropical-based Northern Oscillation Index) and its analog, the SOI* (extratropical-bassed Southern Oscillation Index) are new indices of midlatitude climate fluctuations that show interesting relationships with fluctuations in marine ecosystems and populations. They reflect the variability in equatorial and extratropical teleconnections and represent a wide range of local and remote climate signals. The indices are counterparts to the traditional SOI (Southern Oscillation Index) that relate variability in the atmospheric forcing of climate change in northern and southern midlatitude hemisphere regions.
language code: en); 
""",
        """2020-02-14 15:22:42.0 [tstevens] Remove Concepts 
delete narrower relation (null); 
""" ;
    skos:definition "The NOI (extratropical-based Northern Oscillation Index) and its analog, the SOI* (extratropical-bassed Southern Oscillation Index) are new indices of midlatitude climate fluctuations that show interesting relationships with fluctuations in marine ecosystems and populations. They reflect the variability in equatorial and extratropical teleconnections and represent a wide range of local and remote climate signals. The indices are counterparts to the traditional SOI (Southern Oscillation Index) that relate variability in the atmospheric forcing of climate change in northern and southern midlatitude hemisphere regions."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "NORTHERN OSCILLATION INDEX"@en ;
    gcmd:reference [ gcmd:text "Text Source: NOAA Environmental Research Division, http://www.pfeg.noaa.gov/products/PFEL/modeled/indices/NOIx/noix.html"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/77bb89d9-23a6-47dd-a366-0cd32b00c52e> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/72227178-bb4c-4ff5-98a3-f976aa3f3714> ;
