insert AltLabel (id: null
text: National Institute of Standards and Technology Advanced Radiometer
language code: en); 
insert Definition (id: null
text: NISTAR is an active cavity radiometer designed to measure the energy reflected and emitted from the entire sunlit face of the Earth from its orbit around the Lagrangian point 1 (L1). L1 is a neutral gravity point between Earth and the sun.  This position offers a unique continuous view of the Earth at from sunrise to sunset.
language code: en); 
""" ;
    skos:definition "NISTAR is an active cavity radiometer designed to measure the energy reflected and emitted from the entire sunlit face of the Earth from its orbit around the Lagrangian point 1 (L1). L1 is a neutral gravity point between Earth and the sun.  This position offers a unique continuous view of the Earth at from sunrise to sunset."@en ;
