    skos:definition """The Selective Chopper Radiometer (SCR) is a 16-channel
nonscanning radiometer flown on Nimbus-5 (launched December
1972) for sounding the atmosphere in the infrared spectrum.

Additional information available at
"http://amsglossary.allenpress.com/glossary/browse?s=s&p=24"

[Summary provided by the Glossary of Meteorology]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "SCR"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Selective Chopper Radiometer"@en ] .

