        """2024-10-17 10:35:11.0 [sritz]  
insert AltLabel (id: null
category: primary
text: Libera Wide Field of View Camera
language code: en); 
insert Definition (id: null
text: The Libera Wide Field of View Camera (WFC) is a monochromatic camera operating at 555nm over a 123-degree field of view that will continuously observe the entire Earth disk from low-earth orbit. The WFC provides a unique capability for scene identification and Angular Distribution Model (ADM) generation that supports the interpretation of the Libera radiometer measurements and complements similar measurements from the VIIRS instrument that will fly on JPSS-4 with Libera.
language code: en); 
""",
        """2024-10-22 10:18:06.0 [sritz]  
insert WeightedRelation (id: null
related concept uuid: 10adce36-ce10-4ae6-94f9-211911c7dd15
