      Number_Channels: 16
      Spectral_Frequency_Coverage_Range: 257 eV - 35 KeV
   End_Group
   Online_Resource: http://swoops.lanl.gov/index.html
   Online_Resource: http://ulysses-ops.jpl.esa.int/ulysses/archive/swoops.html
   Sample_Image: http://ulysses-ops.jpl.esa.int/ulysses/images/bai.gif
   Group: Instrument_Logistics
      Data_Rate: 100 kbps
