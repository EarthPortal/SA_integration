<https://gcmd.earthdata.nasa.gov/kms/concept/3a942e8a-d2f2-42bf-9e83-b7b3793b100e> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/57383ac5-614c-4b84-9202-e137b000422b> ;
    skos:definition """Refers to dynamic processess of the Earth's ionosphere and solar magnetosphere\r
triggered by solar events. The magnetosphere is the magnetic cavity surrounding
the earth, carved out of the passing solar wind by virtue of the geomagnetic\r
field, which prevents, or at least impedes, the direct entry of the solar wind\r
plasma into the cavity. The ionosphere is the region of the earth's upper\r
atmosphere containing a small percentage of free electrons and ions produced by
photoionization of the constituents of the atmosphere by solar ultraviolet\r
radiation at very short wavelengths (l.t.1000 angstroms).  The ionosphere\r
significantly influences radiowave propagation of frequencies less than about\r
30 MHz."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/5d290bd8-049b-4002-86c8-8acba563d0e1>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/5f8a9188-d588-4782-a34b-07fa68380c41>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/792cf9f0-6d24-4de8-902c-b74e42c74fd3>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/882d9a10-713c-4b58-8c7b-d9af086115a3>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/8cbdfa00-852c-452d-8013-86145ad318c8>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/990016e0-f247-4c36-8a17-f50e792a964a>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/9abe9fdb-59f3-4bd6-b24f-b9b7e46eae7c>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/ba75172a-6965-40cf-bf3f-6c0af2f97dad>,
        <https://gcmd.earthdata.nasa.gov/kms/concept/e453077b-b6f3-44f0-9f3d-4408bf9a69e5> ;
    skos:prefLabel "IONOSPHERE/MAGNETOSPHERE DYNAMICS"@en ;
    gcmd:reference [ gcmd:text """NOAA/NGDC gloassary of solar-terresrial terms:\r
http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html"""@en ] .

