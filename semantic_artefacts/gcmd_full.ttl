    skos:prefLabel "ISOTOPIC ANALYSIS"@en ;
    gcmd:reference [ gcmd:text "Eddy, J.A. and H. Oeschger, eds. 1993. Global Changes in the Perspective of the Past. Dahlem Workshop Reports, Environmental Sciences Research Report 12, J. Wiley."@en ] .

