<https://gcmd.earthdata.nasa.gov/kms/concept/c5d1a6fc-b484-45cb-be94-2e2a23155d63> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/3466eed1-2fbb-49bf-ab0b-dc08731d502b> ;
    skos:changeNote """2021-08-30 16:17:33.0 [sritz] Insert Concept 
add broader relation (SeaHawk Cubesat [c5d1a6fc-b484-45cb-be94-2e2a23155d63,720880] - Earth Observation Satellites [3466eed1-2fbb-49bf-ab0b-dc08731d502b,711243]); 
""",
        """2021-08-30 16:20:58.0 [sritz]  
insert AltLabel (id: null
category: primary
text: SeaHawk Cubesat
language code: en); 
insert Definition (id: null
text: The goal of the SeaHawk program was to construct and demonstrate the potential scientific applications of a high resolution (~120m) ocean color instruments on a 3U (10cm x 10cm x 30cm) CubeSat Platforms. ACC Clyde (Scotland) provided the CubeSat bus named SeaHawk. Cloudland Instruments (California) provided the Hawkeye Sensor. The program was funded in 2014 by the Gordon and Betty Moore Foundation and is administered by Dr. John Morrison – UNCW. NASA provided “advice and review” during the development phase and with formal NASA/HQ Space Act Agreement (2017), provides services for the collection, processing, calibration, validation, archive and distribution of the data.
language code: en); 
""",
        """2021-08-30 16:51:45.0 [sritz]  
update PrefLabel (SeaHawk); 
""",
        """2021-11-18 12:42:25.0 [tstevens] Move Concepts 
delete broader relation (null); 
add broader relation (SeaHawk [c5d1a6fc-b484-45cb-be94-2e2a23155d63,826717] - Space-based Platforms [b39a69b4-c3b9-4a94-b296-bbbbe5e4c847,835875]); 
""",
        """2021-11-18 13:02:44.0 [tstevens] Move Concepts 
delete broader relation (null); 
add broader relation (SeaHawk [c5d1a6fc-b484-45cb-be94-2e2a23155d63,826717] - Earth Observation Satellites [3466eed1-2fbb-49bf-ab0b-dc08731d502b,826121]); 
""",
        """2022-07-12 17:46:19.0 [sritz] Insert Concept 
add narrower relation (SeaHawk [c5d1a6fc-b484-45cb-be94-2e2a23155d63,972737] - SeaHawk-1 [9215de74-2008-4a64-8760-f58f16ae7d14,982058]); 
""" ;
    skos:definition "The goal of the SeaHawk program was to construct and demonstrate the potential scientific applications of a high resolution (~120m) ocean color instruments on a 3U (10cm x 10cm x 30cm) CubeSat Platforms. ACC Clyde (Scotland) provided the CubeSat bus named SeaHawk. Cloudland Instruments (California) provided the Hawkeye Sensor. The program was funded in 2014 by the Gordon and Betty Moore Foundation and is administered by Dr. John Morrison – UNCW. NASA provided “advice and review” during the development phase and with formal NASA/HQ Space Act Agreement (2017), provides services for the collection, processing, calibration, validation, archive and distribution of the data."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/9215de74-2008-4a64-8760-f58f16ae7d14> ;
    skos:prefLabel "SeaHawk"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "SeaHawk Cubesat"@en ] ;
    gcmd:reference [ gcmd:text """https://oceancolor.gsfc.nasa.gov/data/hawkeye/summary/
https://uncw.edu/socon/index.html"""@en ] .

