        """2024-10-08 13:42:46.0 [tstevens]  
insert Definition (id: null
text: Refers decrease in snow cover. Researchers found snow cover is declining in nearly twice as many grids as it advances. Arctic areas are showing heavy snow cover loss. Along with the general snow decline, there is also a shift in snow coverage. Snow is coming earlier and going away earlier. Snow cover is trending more in November and declining from February to late spring and early summer.
language code: en); 
""" ;
    skos:definition "Refers decrease in snow cover. Researchers found snow cover is declining in nearly twice as many grids as it advances. Arctic areas are showing heavy snow cover loss. Along with the general snow decline, there is also a shift in snow coverage. Snow is coming earlier and going away earlier. Snow cover is trending more in November and declining from February to late spring and early summer."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "SNOW COVER DEGRADATION"@en ;
    gcmd:reference [ gcmd:text "https://climateadaptationplatform.com/climate-change-caused-snowfall-decline-and-its-impact/"@en ] .

