      Launch_Date: 2010-02-11
      Launch_Site: Cape Canaveral/Kennedy Space Center, USA
      Design_Life: 5 years 3 months
      Primary_Sponsor: USA/NASA
   End_Group
End_Group); 
delete Resource (null); 
""" ;
