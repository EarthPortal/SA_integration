<https://gcmd.earthdata.nasa.gov/kms/concept/960f8eb8-6ca9-47d3-ae4a-7e21ebfad4c0> a skos:Concept ;
    skos:altLabel "GLObal NAvigation Satellite System (GLONASS)"@en ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/1506fb17-7ac4-44ce-bde5-074885bdb2d2> ;
    skos:changeNote """2017-08-14 15:11:19.0 [tstevens]  
