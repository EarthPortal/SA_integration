    skos:definition """MAGNETOMETERS measure the Earth's magnetic field intensity. 


Group: Instrument_Details
   Entry_ID: MAGNETOMETERS
   Group: Instrument_Identification
      Instrument_Category: Earth Remote Sensing Instruments
      Instrument_Class: Passive Remote Sensing
      Instrument_Type: Magnetic Field/Electric Field Instruments
      Short_Name: MAGNETOMETERS
   End_Group
   Group: Associated_Platforms
      Short_Name: GRACE
      Short_Name: SUNSAT
   End_Group
   Online_Resource: http://en.wikipedia.org/wiki/Magnetometer
   Group: Instrument_Logistics
      Instrument_Owner: USA/NASA
   End_Group
End_Group"""@en ;
