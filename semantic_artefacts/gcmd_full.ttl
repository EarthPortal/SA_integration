<https://gcmd.earthdata.nasa.gov/kms/concept/1ef327e1-6139-49ff-87c3-f959ea75a511> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/2e83362e-d8f8-4bca-83fd-bae360ebe94b> ;
    skos:definition """The outermost, high temperature region of the solar atmosphere. Above the
chromosphere and transition region, consisting of almost fully ionized plasma
contained in closed magnetic field loops, called coronal loops or expanding out
along open magnetic field lines to form the solar wind. The corona is a highly
rarefied, low density gas, with electron densities of less than 10*16
electrons/ m*3, heated to temperatures of millions of degrees. The corona is
visible to the unaided eye as a white halo during a total eclipse of the sun."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "CORONA"@en ;
    gcmd:reference [ gcmd:text """The Cambridge Encyclopedia of the Sun, The Cambridge University Press,
Cambridge, CB2, 2RU, UK, 2001."""@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/1ef441a3-0fa2-4c1d-81d8-4312dcdde415> a skos:Concept ;
