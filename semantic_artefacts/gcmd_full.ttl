text: HIAPER Airborne Radiation Package
language code: en); 
""",
        """2018-06-06 17:01:52.0 [sritz]  
insert WeightedRelation (id: null
related concept uuid: 879d697c-381f-45df-a48d-2d9095bc5c54
relationship type: null
