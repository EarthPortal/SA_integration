        <https://gcmd.earthdata.nasa.gov/kms/concept/d73ed320-cd5b-4994-a26a-dac5a2fc394f> ;
    skos:prefLabel "BIOGEOCHEMICAL PROCESSES"@en ;
    gcmd:reference [ gcmd:text "Prentice Hall Biology"@en ] .

