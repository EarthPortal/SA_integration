    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/3546cb0a-27a2-4914-85cf-1774b5c4ed19> ;
    skos:definition """Mushrooms are a type of fungi (which are major decomposers that engage
in extracellular digestion and absorption of organic matter). Mushrooms
are of the order Basidiomycota, the club fungi, which have a fruiting body
in the aboveground portion of the plant."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "MUSHROOMS"@en ;
    gcmd:reference [ gcmd:text """Starr, C. and R. Taggart. 1998. Biology: the unity and diversity of life.
Wadsworth Publishing Company. Belmont, California. and Gould, J. and W.Keaton.
1998. Biological Science.  W.W. Norton and Company. New York, New York."""@en ] .

