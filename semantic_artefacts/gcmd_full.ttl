      Long_Name: Thermal Ion Dynamics Experiment
   End_Group
   Group: Associated_Platforms
      Short_Name: POLAR
   End_Group
   Online_Resource: http://xd12srv1.nsstc.nasa.gov/ssl/PAD/sppb/index_Tide.html
   Online_Resource: http://tide.gsfc.nasa.gov/
   Sample_Image: http://xd12srv1.nsstc.nasa.gov/ssl/PAD/sppb/TIDE/images/plate_1_lrg.gif
   Group: Instrument_Logistics
