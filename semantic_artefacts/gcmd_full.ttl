<https://gcmd.earthdata.nasa.gov/kms/concept/6a745a5e-829c-43f5-8d5a-6fb549e7b81b> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/9e5ec924-2fd3-4cbb-a7eb-ffde114d0cb9> ;
    skos:definition """Ammonia (NH3) is a reduced nitrogen gas and is emitted in large quantities from
animal feedstocks, sewerage plants, etc. Ammonia is very soluble in water and
is scavenged from the lower atmosphere by clouds. Ammonia is the most abundant
alkaline gas in the atmosphere and plays a large role in neutralizing acidity
from sulfuric and nitric acids via formation of the ammonium ion."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "AMMONIA"@en ;
    gcmd:reference [ gcmd:text """American Meterological Society. 2000. Glossary of Meteorology, Second Edition.
Boston, MA: American Meteorological Society."""@en ] .

