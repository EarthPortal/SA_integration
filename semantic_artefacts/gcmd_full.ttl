        """2013-11-21 14:10:29.0 [mpmorahan]  
insert AltLabel (id: null
text: JASON-1 Microwave Radiometer
language code: en); 
""" ;
    skos:definition """Jason-1 Microwave Radiometer measures the 18.7 GHz, 23.8 GHz and 34.0 GHz sea surface microwave brightness temperatures. The 18.7 GHz channel provides the wind induced effects in the sea surface background emissions correction. The 23.8 GHz channel measures water vapor. The 34.0 GHz channel measures the cloud liquid water to be corrected. All together the three frequencies provide the error in the satellite range measurement caused by pulse delay due to water vapor.


Group: Instrument_Details
   Entry_ID: JASON-1 Microwave Radiometer
   Group: Instrument_Identification
      Instrument_Category: Earth Remote Sensing Instruments
      Instrument_Class: Passive Remote Sensing
      Instrument_Type: Spectrometers/Radiometers
      Instrument_Subtype: Radiometers
      Short_Name: JASON-1 Microwave Radiometer
      Long_Name: JASON-1 Microwave Radiometer
   End_Group
   Group: Associated_Platforms
      Short_Name: JASON-1
   End_Group
   Group: Spectral_Frequency_Information
      Wavelength_Keyword: MICROWAVE
      Spectral_Frequency_Coverage_Range: 41.6 km at 18.7 GHz, 36.1 km at 23.8 GHz, 22.9 km at 34 GHz
      Spectral_Frequency_Resolution: ~1.0 cm - ~100 cm
   End_Group
   Online_Resource: http://podaac.jpl.nasa.gov/Jason1
   Sample_Image: http://sealevel.jpl.nasa.gov/images/ostm/newsroom/features/images/200608-1b.jpg
   Creation_Date: 2013-11-21
   Group: Instrument_Logistics
      Instrument_Start_Date: 2001-12-09
      Instrument_Stop_Date: 2013-07-03
      Instrument_Owner: CNES
      Instrument_Owner: NASA
   End_Group
End_Group"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "JASON-1 Microwave Radiometer"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "JASON-1 Microwave Radiometer"@en ] ;
    gcmd:resource [ gcmd:type "IMAGE" ;
            gcmd:url "http://sealevel.jpl.nasa.gov/images/ostm/newsroom/features/images/200608-1b.jpg" ] .

