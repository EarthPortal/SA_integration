    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/cda9b483-8711-42b8-82f9-e7d22ce9c62c> ;
    skos:definition """Airspeed is the speed on an exposed (usually airborne) object relative to the\r
atmosphere. \r
In a calm atmosphere, airspeed equals ground speed. Ground speed is the speed\r
of an airborne object relative to the earth's surface.	It is the magnitude of\r
the vector sum of the object's velocity with respect to the air and the wind\r
velocity, or, expressed in a different manner, the algebraic sum of the\r
aircraft's airspeed and the wind factor."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "AIRSPEED/GROUND SPEED"@en ;
    gcmd:reference [ gcmd:text """American Meteorological Society Glossary of Meteorology Online.\r
"http://amsglossary.allenpress.com/glossary\""""@en ] .

