   End_Group
   Group: Synonymous_Platform_Names
      Short_Name: TITAN II (9)
   End_Group
   Group: Orbit
      Orbit_Inclination: 28.86 degrees
      Perigee: 270 km
      Apogee: 272 km
   End_Group
   Creation_Date: 2008-01-24
   Online_Resource: http://www.astronautix.com/flights/gemini9.htm
   Sample_Image: http://www.astronautix.com/graphics/0/10074373.jpg
   Group: Platform_Logistics
      Launch_Date: 1966-06-03
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
