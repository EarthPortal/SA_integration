    skos:definition """The Arctic Oscillation (AO) is the dominant pattern of non-seasonal\r
sea-level pressure (SLP) variations north of 20N, and it is\r
characterized by SLP anomalies of one sign in the Arctic and anomalies\r
of opposite sign centered about 37-45N. Additional information is\r
available for the Arctic Oscillation (AO) and for the North Atlantic\r
Oscillation (NAO), a close relative of the AO \r
(http://jisao.washington.edu/ao/)"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "ARCTIC OSCILLATION"@en ;
    gcmd:reference [ gcmd:text """Joint Institute for the Study of the Atmosphere and Ocean, U. Washington\r
http://jisao.washington.edu/ao/"""@en ] .

