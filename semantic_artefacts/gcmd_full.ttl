        """2019-11-25 12:17:56.0 [mmorahan]  
insert AltLabel (id: null
category: primary
text: Glacier and Land Ice Surface Topography Interferometer
language code: en); 
insert Definition (id: null
text: The upgraded airborne Glacier and Ice Surface Topography Interferometer (GLISTIN-A) flew initial (8/6/12 and 8/13/12) and final (1/17/13 and 2/26/13) checkout flights on a DFRC G-III (C-20).
-  Initial assessments of the Ka-band single pass interferometer (which is an interface to UAVSAR)  show system performance consistent with prediction
-  Instrument integration and flight process improvements have been implemented
Glacier and Ice Surface Topography Interferometer (GLISTIN) will provide all-weather, high-resolution swath ice surface topography, not available through existing lidar (i.e. ICESAT-2) or radar (CryoSAT) sensors
language code: en); 
insert Resource (id: null
type: provider
url: https://airbornescience.jpl.nasa.gov/instruments/glistin); 
""" ;
    skos:definition """The upgraded airborne Glacier and Ice Surface Topography Interferometer (GLISTIN-A) flew initial (8/6/12 and 8/13/12) and final (1/17/13 and 2/26/13) checkout flights on a DFRC G-III (C-20).
-  Initial assessments of the Ka-band single pass interferometer (which is an interface to UAVSAR)  show system performance consistent with prediction
-  Instrument integration and flight process improvements have been implemented
Glacier and Ice Surface Topography Interferometer (GLISTIN) will provide all-weather, high-resolution swath ice surface topography, not available through existing lidar (i.e. ICESAT-2) or radar (CryoSAT) sensors"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
