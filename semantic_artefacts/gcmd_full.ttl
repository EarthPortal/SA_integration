   Sample_Image: http://www.nasa.gov/images/content/136249main_sts-59-crew-sm.jpg
   Group: Platform_Logistics
      Launch_Date: 1994-04-09
      Primary_Sponsor: NASA
   End_Group
End_Group"""@en ;
