        """2024-11-22 09:02:54.0 [tstevens]  
insert AltLabel (id: null
category: primary
text: SMOS L-Band Radiometer
language code: en); 
insert Definition (id: null
text: Funded by the European Space Agency (ESA), the Soil Moisture and Ocean Salinity (SMOS) mission was launched on 2 November 2009. Its first mission is to provide, from microwave L-band measurements, global observations of variability in soil moisture and sea surface salinity due to continuous exchange in Earth's water cycle between the oceans, the atmosphere and the land. These key geophysical parameters, soil moisture for hydrology studies and salinity for enhanced understanding of ocean circulation, are both vital for climate change models.
language code: en); 
""" ;
    skos:definition "Funded by the European Space Agency (ESA), the Soil Moisture and Ocean Salinity (SMOS) mission was launched on 2 November 2009. Its first mission is to provide, from microwave L-band measurements, global observations of variability in soil moisture and sea surface salinity due to continuous exchange in Earth's water cycle between the oceans, the atmosphere and the land. These key geophysical parameters, soil moisture for hydrology studies and salinity for enhanced understanding of ocean circulation, are both vital for climate change models."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "SMOS L-BAND RADIOMETER"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "SMOS L-Band Radiometer"@en ] ;
    gcmd:reference [ gcmd:text "https://earth.esa.int/eogateway/missions/smos"@en ] .

