        <https://gcmd.earthdata.nasa.gov/kms/concept/9a46a62c-952d-4253-8249-7375c14068a2> ;
    skos:prefLabel "GEOMAGNETIC FORECASTS"@en ;
    gcmd:reference [ gcmd:text "NOAA Space Weather Prediction Center"@en ] .

