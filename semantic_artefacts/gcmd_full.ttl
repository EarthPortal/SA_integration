<https://gcmd.earthdata.nasa.gov/kms/concept/b99ca460-10c8-400e-b3e2-a8774eb09fdf> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/b5e4912d-3224-4d7b-924c-a697677775c6> ;
    skos:definition """The Ultraviolet Spectrometer and Polarimeter (UVSP) was designed
to measure the relatively low-temperature plasmas (5000 to
200,000 K) in flares, active regions and the quiet Sun.  The
wavelength range given above could be scanned.  Spatial
resolution in some observations is as good as 1 arc sec, and
the field of view could be varied by raster scanning to build
up images as large as 256 arc sec square.  (Some larger
images were made by adjusting the spacecraft fine pointing
between rasters.)

[Source: NASA]"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "UVSP"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Ultraviolet Spectrometer and Polarimeter"@en ] .

