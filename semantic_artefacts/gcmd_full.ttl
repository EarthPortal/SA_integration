        """2024-03-08 11:49:56.0 [sritz]  
insert AltLabel (id: null
category: primary
text: S-band Synthetic Aperture Radar
language code: en); 
insert Definition (id: null
text: The 12cm wavelength S-SAR supplied by ISRO is the secondary radar and is composed of 48 S-band transmit/receive array elements in 2 rows, 24 per polarization. The S-SAR will be used to produce data over science areas of interest to India that are above and beyond the NASA requirements. The areas include coastal bathymetry (depth of water) and ocean winds, geology over India, and coastal shoreline studies. The S-band is also sensitive to light vegetation and will be used in polar regions, as its signal is less sensitive to ionospheric disturbances.
language code: en); 
""" ;
    skos:definition "The 12cm wavelength S-SAR supplied by ISRO is the secondary radar and is composed of 48 S-band transmit/receive array elements in 2 rows, 24 per polarization. The S-SAR will be used to produce data over science areas of interest to India that are above and beyond the NASA requirements. The areas include coastal bathymetry (depth of water) and ocean winds, geology over India, and coastal shoreline studies. The S-band is also sensitive to light vegetation and will be used in polar regions, as its signal is less sensitive to ionospheric disturbances."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "S-SAR"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "S-band Synthetic Aperture Radar"@en ] ;
    gcmd:reference [ gcmd:text "https://nisar.jpl.nasa.gov/mission/observatory/radars/"@en ] .

