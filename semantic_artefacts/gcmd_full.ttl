      Short_Name: NAST-M
      Long_Name: NPOESS Aircraft Sounder Testbed-Microwave Radiometer
   End_Group
   Group: Associated_Platforms
      Short_Name: NASA ER-2
   End_Group
   Online_Resource: http://www.ipo.noaa.gov/index.php?pg=nast
End_Group"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "NAST-M"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "NPOESS Aircraft Sounder Testbed-Microwave Radiometer"@en ] .

