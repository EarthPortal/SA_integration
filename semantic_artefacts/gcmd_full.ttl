    skos:prefLabel "SIM"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Spectral Irradiance Monitor"@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/339fea8e-c365-4296-82e6-75759e3fc410> a skos:Concept ;
