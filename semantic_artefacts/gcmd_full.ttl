    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/a031952d-9f00-4ba5-9966-5f87ab9dfdd4> ;
    skos:definition """Also called the surface zone. The ocean mixed layer is the upper layer
of ocean in which temperature and salinity are relatively constant with
depth. Depending on local conditions, the surface layer may reach to 1,000
meters (3,300 feet) or be absent entirely."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "OCEAN MIXED LAYER"@en ;
    gcmd:reference [ gcmd:text """Garrison, T. 1993. Oceanography, an Invitation to Marine Science. Wadsworth
Publishing Co. p. 527."""@en ] .

