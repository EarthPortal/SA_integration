<https://gcmd.earthdata.nasa.gov/kms/concept/86b43d3e-92bb-436b-9d56-a5de4ac23ef1> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/78c70202-ab05-40d6-90db-563be2a8dc90> ;
    skos:definition """The Continuous Underway Fish Egg Sampler (CUFES) is a, recently
developed, plankton sampling device that provides
high-resolution maps of fish eggs by sieving the eggs from water
pumped from a fixed depth (usually 3 m) while a survey ship is
underway. Concurrently, environmental data are collected, stored
and processed by means of a set of instruments and probes,
installed onboard, and software that handles the
information. Most systems record date, time, position (GPS),
water flow, temperature, conductivity (salinity) and
fluorescence (chlorophyll).

Additional information available at
"http://ipimar-iniap.ipimar.pt/pelagicos/english/news/sampling.html"2003"""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "CUFES"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Continuous Underway Fish Egg Sampling System"@en ] .

