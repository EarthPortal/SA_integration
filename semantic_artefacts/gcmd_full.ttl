        <https://gcmd.earthdata.nasa.gov/kms/concept/a4f1da9a-eda0-4240-90a0-074d58a713ba> ;
    skos:prefLabel "BUILDING BLOCKS"@en ;
    gcmd:reference [ gcmd:text "https://medlineplus.gov/genetics/understanding/howgeneswork/makingprotein/#:~:text=The%20flow%20of%20information%20from,is%20used%20to%20make%20proteins."@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/4cc9b4fa-5097-447f-914c-eb90820938c6> a skos:Concept ;
