<https://gcmd.earthdata.nasa.gov/kms/concept/4931dcac-8b89-4bc9-ba59-469cfdcf6f12> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/376a1d5c-2496-4381-981f-bc047af92044> ;
    skos:definition """A general term referring to all types of ice contained in freezing and frozen\r
ground. Ground ice occurs in pores, cavities, voids or other openings in soil\r
or rock and includes massive ice. It may occur as lenses, wedges, veins,\r
sheets, seams, irregular masses, or as individual crystals or coatings on\r
mineral or organic particles. Perennial ground ice can only occur within\r
permafrost bodies."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "GROUND ICE"@en ;
    gcmd:reference [ gcmd:text "From the National Snow and Ice Data Center (NSIDC): \"http://nsidc.org\""@en ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/494ce358-a27e-41da-8858-17d224715ddd> a skos:Concept ;
