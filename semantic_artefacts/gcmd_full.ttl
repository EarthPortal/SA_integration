delete broader relation (null); 
add broader relation (NCEP-MRF [6426710e-8498-4308-845e-c9c543bcc17e,826315] - Models [0a184cdc-c074-4946-90a6-02f03c686341,835911]); 
""",
        """2024-11-19 09:09:49.0 [tstevens]  
insert Definition (id: null
text: The Nested Grid Model (NGM) and Medium Range Forecast (MRF) Archive is historical digital data set DSI-6140, archived at the NOAA National Centers for Environmental Information (NCEI). The National Centers for Environmental Prediction (NCEP) of the National Weather Service (NWS) runs a series of computer analyses and forecasts operationally, which use or produce model data. This data set is one of several NCEP sets of model data archived at NCEI. Historical data set DSI-6140 consists of two subgroups of NCEP model data: NGM and MRF for the time period January 1, 1991 through April 15, 1997. Geographic coverage is the 48 contiguous states of the United States of America, plus adjacent waters and southern Canada. Major parameters provided by NGM are ice covered water areas (yes/no), snow covered areas (yes/no), terrain height, mean sea level pressure, convective precipitation, total precipitation, exchange coefficient at surface, upward turbulent flux of sensible heat, upward turbulent flux of water, surface pressure, number of mixed layers next to surface, u component of wind, v component of wind, vertical velocity, specific humidity, and temperature. Parameters provided by MRF are surface temperature, geopotential height, and relative humidity. DSI-6140 is the historical precursor data set to digital data set DSI-6141, NCEP EDAS and GDAS (FNL) Model Data, also archived at NCEI.
language code: en); 
""" ;
    skos:definition "The Nested Grid Model (NGM) and Medium Range Forecast (MRF) Archive is historical digital data set DSI-6140, archived at the NOAA National Centers for Environmental Information (NCEI). The National Centers for Environmental Prediction (NCEP) of the National Weather Service (NWS) runs a series of computer analyses and forecasts operationally, which use or produce model data. This data set is one of several NCEP sets of model data archived at NCEI. Historical data set DSI-6140 consists of two subgroups of NCEP model data: NGM and MRF for the time period January 1, 1991 through April 15, 1997. Geographic coverage is the 48 contiguous states of the United States of America, plus adjacent waters and southern Canada. Major parameters provided by NGM are ice covered water areas (yes/no), snow covered areas (yes/no), terrain height, mean sea level pressure, convective precipitation, total precipitation, exchange coefficient at surface, upward turbulent flux of sensible heat, upward turbulent flux of water, surface pressure, number of mixed layers next to surface, u component of wind, v component of wind, vertical velocity, specific humidity, and temperature. Parameters provided by MRF are surface temperature, geopotential height, and relative humidity. DSI-6140 is the historical precursor data set to digital data set DSI-6141, NCEP EDAS and GDAS (FNL) Model Data, also archived at NCEI."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/platforms> ;
    skos:prefLabel "NCEP-MRF"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "NCEP Medium Range Forecast Model"@en ] ;
    gcmd:reference [ gcmd:text "https://www.ncei.noaa.gov/access/metadata/landing-page/bin/iso?id=gov.noaa.ncdc:C00413"@en ] .

