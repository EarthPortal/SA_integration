      Instrument_Class: Passive Remote Sensing
      Instrument_Type: Spectrometers/Radiometers
      Instrument_Subtype: Spectrometers
      Short_Name: CAPS
      Long_Name: Cloud, Aerosol, Precipitation Spectrometer
   End_Group
   Group: Associated_Platforms
      Short_Name: DHC-6
      Short_Name: DC-8
   End_Group
   Online_Resource: http://www.dropletmeasurement.com/index.php?option=com_content&view=article&id=48&Itemid=28
End_Group"""@en ;
