<https://gcmd.earthdata.nasa.gov/kms/concept/429d42ef-9b58-4068-b389-0a9e60e55486> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/2e83362e-d8f8-4bca-83fd-bae360ebe94b> ;
    skos:definition """An area seen as a dark spot on the PHOTOSPHERE of the sun.  Sunspots\r
are concentrations of magnetic flux, typically occurring in bipolar\r
clusters or groups.  They appear dark because they are cooler than the\r
surrounding photosphere. Sunspots are classified as to their group\r
characteristics (called the Zurich Sunspot Classification; older sunspot\r
counting schemes may have used the Wolf Sunspot Number classification).\r
Satellite observations of the sun (notably by the ACRIM and ERBE sensors)\r
have demonstrated a correlation between sunspot luminosity changes and\r
sunspot numbers - a possible influencing factor in Earth's climate\r
dynamics."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "SUNSPOTS"@en ;
    gcmd:reference [ gcmd:text """On-Line Glossary of Solar-Terrestrial Terms from the NOAA Space Environment\r
Laboratory.  "http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html\""""@en ] .

