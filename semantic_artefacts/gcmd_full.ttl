<https://gcmd.earthdata.nasa.gov/kms/concept/cece77b6-42bf-44f6-9193-050cbc5f4cf7> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/860e2af9-ce29-4f3f-b027-ae3747eb3e01> ;
    skos:definition """The reflectance properties of ice bodies. A smooth ice surface will act as\r
a near-specular reflector. As surface roughness increases, the reflection\r
becomes diffuse. It is the ratio of the intensity of reflected radiation\r
to that of the incident radiation on a surface. The suffix (-ance) implies\r
a property of that particular specimen surface."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "REFLECTANCE"@en ;
    gcmd:reference [ gcmd:text """Canadian Centre for Remote Sensing, Remote Sensing Glossary.See:
"http://www.ccrs.nrcan.gc.ca/ccrs/eduref/ref/glosndxe.html\""""@en ] .

