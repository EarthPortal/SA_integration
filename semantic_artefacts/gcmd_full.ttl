    skos:prefLabel "ATMOSPHERIC RADON"@en ;
    gcmd:reference [ gcmd:text "Haynes, William M., ed. (2011). CRC Handbook of Chemistry and Physics (92nd ed.). Boca Raton, FL: CRC Press. p. 4.122. ISBN 1439855110."@en ] .

