   End_Group
   Group: Orbit
      Orbit_Type: LEO > Low Earth Orbit > Polar Sun-Synchronous
   End_Group
   Creation_Date: 2009-12-18
   Online_Resource: https://hyspiri.jpl.nasa.gov/
   Group: Platform_Logistics
      Primary_Sponsor: USA/NASA
   End_Group
End_Group); 
update Definition (NASA Hyperspectral Infrared Imager, https://hyspiri.jpl.nasa.gov/); 
delete Resource (null); 
""" ;
