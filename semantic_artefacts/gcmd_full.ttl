<https://gcmd.earthdata.nasa.gov/kms/concept/aa866680-32cd-4bd2-88ee-ae7b45c629da> a skos:Concept ;
    skos:altLabel "DMSP-F10"@en ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/1cf8cbcd-c1be-4c78-9272-b62adad59aa1> ;
