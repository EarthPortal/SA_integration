<https://gcmd.earthdata.nasa.gov/kms/concept/e4fcb001-f517-4295-89dd-73292e0bf3ee> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/2e83362e-d8f8-4bca-83fd-bae360ebe94b> ;
    skos:definition """Solar velocity fields are also known as differential rotation. The sun rotates
slightly more rapidly at the equator than at the poles. Gases at the equator
make about 10 rotations, whiles gases at midlatitudes rotates 9 times and gases
at the poles rotates about 7 times. This produces a shear in the gas motions
and a pronounced E-W orientation of the magnetic field."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "SOLAR VELOCITY FIELDS"@en ;
    gcmd:reference [ gcmd:text "http://astrowww.phys.uvic.ca/grads/simard/phd/root/node34.html"@en ] .

