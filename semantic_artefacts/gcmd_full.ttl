    skos:definition """A faint visual phenomenon associated with geomagnetic activity,\r
which occurs mainly in the high-latitude night sky.  Typical\r
auroras are 100 to 250 km above the ground.   The phenomenon\r
caused by collisions between charged particles, atoms, and ions\r
in the Earth's ionosphere and upper atmosphere."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:prefLabel "AURORAE"@en ;
    gcmd:reference [ gcmd:text """NOAA/NGDC Solar-Terrestrial Gloassary\r
http://www.ngdc.noaa.gov/stp/GLOSSARY/glossary.html"""@en ] .

