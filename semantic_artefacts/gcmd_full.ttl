<https://gcmd.earthdata.nasa.gov/kms/concept/de7647c9-b129-4cba-afe4-63fa9998206e> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/4ad0c52d-6449-48ff-8678-adc6b2cebcb7> ;
    skos:changeNote """2019-06-21 11:04:49.0 [sritz] Insert Concept 
add narrower relation (SOLAR IRRADIANCE [de7647c9-b129-4cba-afe4-63fa9998206e,85399] - SHORTWAVE DOWNWARD IRRADIANCE [e1af236f-ee88-4b10-8feb-70d9e09f90be,368891]); 
""" ;
    skos:definition """Solar irradiance at the top of the atmosphere on a plane normal to the
incident radiation, and at the mean distance of the Earth from the Sun.
Solar irradiance is also referred to as the solar constant. In satellite
remote sensing, the solar irradiance is used as an onboard calibrartion of
visible band sensors. Some climate studies suggest that small variations
in the solar irradiance associated with solar activity over days to
decades may have an effect the Earth's climate."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skos:narrower <https://gcmd.earthdata.nasa.gov/kms/concept/e1af236f-ee88-4b10-8feb-70d9e09f90be> ;
    skos:prefLabel "SOLAR IRRADIANCE"@en ;
    gcmd:reference [ gcmd:text """Maunder, W.J. 1994. Dictionary of Global Climate Change, 2nd. ed. Chapman and
Hall, NY. Carleton, A.M. Satellite Remote Sensing in Climatology, Belhaven
Press, London, UK."""@en ] .

