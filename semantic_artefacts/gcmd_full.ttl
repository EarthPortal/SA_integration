            gcmd:text "Wide Field Camera"@en ] ;
    gcmd:resource [ gcmd:type "IMAGE" ;
            gcmd:url "http://www-calipso.larc.nasa.gov/about/images/payload.jpg" ] .

<https://gcmd.earthdata.nasa.gov/kms/concept/6285338b-3ec4-4ecc-962f-ee6fc2d80c7e> a skos:Concept ;
    skos:broader <https://gcmd.earthdata.nasa.gov/kms/concept/eceec9a6-1311-4028-8433-1f6d21b62d4d> ;
    skos:definition """The BIONESS (Bedford Institute of Oceanography, Net Environmental Sampling
System) is a series of 9 nets that are opened and closed in sequence. BIONESS
tows are done obliquely (diagonally) through the water at given depths. A CTD
unit is attached to the frame of the BIONESS and allows in situ display of
conductivity, temperature, depth, and % light transmission within the water. We
use our BIONESS in combination with a scientific echo sounder to strategically
sample locations of high biomass within the water column."""@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/instruments> ;
    skos:prefLabel "BIONESS"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Bedford Institute of Oceanography Net Environmental Sampling System"@en ] .

