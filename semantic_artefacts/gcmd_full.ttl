category: null
text: JPS, JPG
language code: en); 
insert Definition (id: null
text: JPEG is a commonly used method of lossy compression for digital images, particularly for those images produced by digital photography. The degree of compression can be adjusted, allowing a selectable tradeoff between storage size and image quality. JPEG typically achieves 10:1 compression with little perceptible loss in image quality. Since its introduction in 1992, JPEG has been the most widely used image compression standard in the world and the most widely used digital image format, with several billion JPEG images produced every day as of 2015.
language code: en); 
""",
        """2022-08-11 09:02:11.0 [tstevens]  
update Definition (https://docs.fileformat.com/image/jpeg/); 
""" ;
    skos:definition "JPEG is a commonly used method of lossy compression for digital images, particularly for those images produced by digital photography. The degree of compression can be adjusted, allowing a selectable tradeoff between storage size and image quality. JPEG typically achieves 10:1 compression with little perceptible loss in image quality. Since its introduction in 1992, JPEG has been the most widely used image compression standard in the world and the most widely used digital image format, with several billion JPEG images produced every day as of 2015."@en ;
    skos:inScheme <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/DataFormat> ;
    skos:prefLabel "JPEG"@en ;
    gcmd:altLabel [ gcmd:category "primary"@en ;
            gcmd:text "Joint Photographic Experts Group Format"@en ] ;
    gcmd:reference [ gcmd:text "https://docs.fileformat.com/image/jpeg/"@en ] .

