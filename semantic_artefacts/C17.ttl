        skos:definition        "{\"node\": {\n    \"decommissioned\": \"1987-09-06\",\n    \"platformclass\": \"vessel of opportunity\",\n    \"notes\": \"General cargo ship built in 1955 as Ulsnes (til Dec 1971) then became Austri (til 31 Dec 1972) then changed to Endurer (til 16 Nov 1976) then registered in the UK as Gardline Endurer (17 Nov 1976 til 23 Dec 1982)  and then Endurer (21 Jan 1986 til 06 Sept 1987).  She was then sold again, renamed La Vie Drole Express (16 Nov 1988) and re-registered in Honduras (later renamed Only One Express).  Status dead Mar 2000.\",\n    \"previous_name\": \"Gardline Endurer, Endurer, Austri, Ulsnes\",\n    \"commissioned\": \"1986-01-21\"\n}}"@en;
        skos:notation          "SDN:C17::74ER";
