<http://vocab.nerc.ac.uk/collection/C17/current/74B8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C17::74B8";
        dc:date                "2016-01-20 12:21:51.0";
        dc:identifier          "SDN:C17::74B8";
        pav:authoredOn         "2016-01-20 12:21:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C17/current/74B8/6/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C17/current/74B8/4/> , <http://vocab.nerc.ac.uk/collection/C17/current/74B8/3/> , <http://vocab.nerc.ac.uk/collection/C17/current/74B8/5/> , <http://vocab.nerc.ac.uk/collection/C17/current/74B8/1/> , <http://vocab.nerc.ac.uk/collection/C17/current/74B8/2/>;
        pav:version            "6";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "6";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L06/current/32/>;
        skos:definition        "{\"node\": {\n    \"country\": \"United Kingdom\",\n    \"decommissioned\": 2000,\n    \"platformclass\": \"vessel of opportunity\",\n    \"notes\": \"Owned by Scottish Shire Line, operated by Container Fleets Ltd of London. 1980 - operated by Overseas Containers Ltd. 1986 - Overseas Containers were bought by P and O and Encounter Bay became part of the P and O Containers Ltd fleet. In 1999 Greenpeace and Basel Action Network (BAN) activists escorted the toxic-contaminated ship Encounter Bay as it arrived in Singapore harbor to protest against the export of toxic waste to Asia. The ship was making its final journey before being scrapped.  The ship, which was sold en route to Singapore and was contaminated with high levels of toxic and hazardous materials, including heavy metals and asbestos. Greenpeace and BAN targeted the Encounter Bay as an example of waste ships that are exported to Asia each year to be scrapped without first being decontaminated.  The Encounter Bay, was sold by its Anglo-Dutch owner P and O Nedlloyd to a Chinese shipbreaker for US$1.5 million.\",\n    \"commissioned\": 1968\n}}"@en;
        skos:notation          "SDN:C17::74B8";
        skos:note              "accepted"@en;
        skos:prefLabel         "Encounter Bay"@en .

