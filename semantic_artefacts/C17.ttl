        owl:deprecated         "false";
        owl:versionInfo        "13";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"country\": \"United Kingdom\",\n    \"decommissioned\": 2010,\n    \"platformclass\": \"vessel of opportunity\",\n    \"notes\": \"Ro/ro vessel built in 1971 as Juno (registered in Finland). Sold, renamed and re-registered numerous times before being registered in the UK as the vessel Hascosay on 1 May 2002. Northlink Ferry between Aberdeen-Kirkwall-Lerwick Freight(2004 - 2010). Used to collect data for the JCDP during 2004. Previous names include Sea Clipper (from May 2001); Transbaltica (from Mar 1998); Sea Clipper (from Oct 1996); Commodore Clipper (from Jan 1991); Euro Nor (from May 1990); Misida (from Nov 1986); Normandia (from Jun 1979) and Juno (from Oct 1975). Became ABOU KARIM I (LB) in 2010, total loss in 2020.\",\n    \"built\": 1971,\n    \"callsign\": \"VSRH4\",\n    \"length\": 118.44,\n    \"previous_name\": \"Sea Clipper, Transbaltica, Sea Clipper, Commodore Clipper, Euro Nor, Misida, Normandia, Juno\",\n    \"IMO\": 7120768,\n    \"title\": \"MV\",\n    \"commissioned\": \"2002-05-01\"\n}}"@en;
        skos:notation          "SDN:C17::74H1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hascosay"@en .

