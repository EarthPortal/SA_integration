<http://vocab.nerc.ac.uk/collection/C17/current/746S/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C17::746S";
        dc:date                "2013-03-17 14:08:01.0";
        dc:identifier          "SDN:C17::746S";
        pav:authoredOn         "2013-03-17 14:08:01.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C17/current/746S/10/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C17/current/746S/1/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/7/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/5/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/9/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/4/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/2/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/8/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/3/> , <http://vocab.nerc.ac.uk/collection/C17/current/746S/6/>;
        pav:version            "10";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "10";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L06/current/31/>;
        skos:definition        "{\"node\": {\n    \"country\": \"United Kingdom\",\n    \"decommissioned\": 1905,\n    \"platformclass\": \"research vessel\",\n    \"notes\": \"Scottish National Antarctic Expedition vessel 1902-1904.  Former Norwegian whaling ship Hekla re-fitted and renamed SY Scotia. In 1905, after her success on the 1902-1904 Scottish National Antarctic Expedition under the leadership of William S Bruce, the exploration ship Scotia was sold for £5019 and ninepence to a Dundee consortium, which intended to return the vessel to its original purpose of whaling.  Initially, after a single unsuccessful trip to Greenland, the Scotia was laid up. Then, after the sinking of Titanic in April 1912, she was fitted with wireless and brought back into active service as part of the North Atlantic ice patrol, once again under the command of Captain Thomas Robertson. Fate unknown.\",\n    \"previous_name\": \"Hekla\",\n    \"title\": \"SY\",\n    \"commissioned\": 1902\n}}"@en;
        skos:notation          "SDN:C17::746S";
        skos:note              "accepted"@en;
        skos:prefLabel         "Scotia"@en .

