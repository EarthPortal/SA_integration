        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"country\": \"United States\",\n    \"notes\": \"Multiple hull issue. NOAA/WOD identify this code as USNS Wilkes (T-AGS-33 1971-1979). Data in WOD in batches 1943-1945 and 1972-1995. First batch matches USS Wilkes (DD 441). Second batch partially matches T-AGS-33, but she is reported (one source) out of service from 1979 until transferred to Tunisia in 1995. Of course, this report might be incorrect.\"\n}}"@en;
        skos:notation          "SDN:C17::319W";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Wilkes"@en .

