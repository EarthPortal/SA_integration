<http://vocab.nerc.ac.uk/collection/C17/current/18A4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C17::18A4";
        dc:date                "2014-07-23 13:28:44.0";
        dc:identifier          "SDN:C17::18A4";
