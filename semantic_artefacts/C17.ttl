        skos:broader           <http://vocab.nerc.ac.uk/collection/L06/current/31/>;
        skos:definition        "{\"node\": {\n    \"country\": \"Canada\",\n    \"decommissioned\": 1988,\n    \"platformclass\": \"research vessel\",\n    \"notes\": \"WOD code 985. Side trawler. Groundfish cruises in the northeast Pacific Ocean from as early as 1963 to as late as 1986, used mainly by the Pacific Biological Station (Nanaimo). Became Western Horizon, then Viking Sur.\",\n    \"built\": \"1962-11\",\n    \"callsign\": \"CGBQ\",\n    \"length\": 54,\n    \"IMO\": 5404342,\n    \"title\": \"FV\",\n    \"commissioned\": 1963\n}}"@en;
        skos:notation          "SDN:C17::18RB";
        skos:note              "accepted"@en;
        skos:prefLabel         "G. B. Reed"@en .

<http://vocab.nerc.ac.uk/collection/C17/current/31VE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C17::31VE";
        dc:date                "2016-04-13 14:06:19.0";
        dc:identifier          "SDN:C17::31VE";
        pav:authoredOn         "2016-04-13 14:06:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C17/current/31VE/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C17/current/31VE/2/> , <http://vocab.nerc.ac.uk/collection/C17/current/31VE/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L06/current/31/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG04/>;
        skos:definition        "{\"node\": {\n    \"country\": \"United States\",\n    \"decommissioned\": 1981,\n    \"platformclass\": \"research vessel\",\n    \"notes\": \"Built 1923 for E. F. Hutton as private yacht, christened Hussar. Sold 1934 to G. Ungar Vetlesen, renamed Vema. Appropriated by U.S. government for coastal patrol during WWII, later converted to barracks/training for merchant marine. Sold 1953 to Columbia University, converted to research vessel and operated by Lamont-Doherty Earth Observatory, retired 1981 after 1,225,000 nautical miles (world record). Sold 1982 to Windjammer Barefoot Cruises, renamed Mandalay. Length 202 feet. IOC Ship Code 18VM. WOD Ship Code 2110.\",\n    \"callsign\": \"J8RU\",\n    \"previous_name\": \"Hussar\",\n    \"IMO\": 7738383,\n    \"title\": \"RV\",\n    \"commissioned\": 1953\n}}"@en;
        skos:notation          "SDN:C17::31VE";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vema"@en .

